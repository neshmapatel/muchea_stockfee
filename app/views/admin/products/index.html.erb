<% content_for :title, "Manage Products & Catalog" %>

<div class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-black text-bush-900 tracking-tight">Product Catalog Management</h1>
      <p class="text-xs text-stone-500 mt-1">Add, edit, or remove retail stockfeed, supplements, and farm supplies.</p>
    </div>

    <div class="flex items-center gap-2">
      <%= link_to new_admin_product_path, class: "px-4 py-2 bg-emerald-700 hover:bg-emerald-800 text-white rounded-xl text-xs font-black transition shadow flex items-center gap-1.5" do %>
        <span>➕ Add New Product</span>
      <% end %>
      <%= link_to "Live Inventory Manager →", admin_inventory_index_path, class: "px-4 py-2 bg-bush-800 hover:bg-bush-900 text-white rounded-xl text-xs font-bold transition shadow" %>
    </div>
  </div>

  <!-- Filter & Search Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="flex items-center gap-2">
      <%= form_with url: admin_products_path, method: :get, local: true, class: "flex gap-2" do |f| %>
        <%= f.text_field :q, value: params[:q], placeholder: "Search product name or brand...", class: "px-3 py-1.5 rounded-lg border border-stone-300 text-xs bg-white focus:outline-none w-64" %>
        <%= f.submit "Search", class: "px-3 py-1.5 bg-bush-800 text-white rounded-lg text-xs font-semibold cursor-pointer" %>
        <% if params[:q].present? || params[:category_id].present? %>
          <%= link_to "Clear", admin_products_path, class: "px-2 py-1.5 text-xs text-stone-500 hover:text-stone-800" %>
        <% end %>
      <% end %>
    </div>

    <div class="flex items-center gap-2 overflow-x-auto pb-1 text-xs">
      <%= link_to "All (#{Product.count})", admin_products_path, class: "px-3 py-1 rounded-lg font-bold transition #{params[:category_id].blank? ? 'bg-bush-800 text-white' : 'bg-white text-stone-700 border border-stone-200'}" %>
      <% @categories.each do |cat| %>
        <%= link_to "#{cat.name} (#{cat.products.count})", admin_products_path(category_id: cat.id), class: "px-3 py-1 rounded-lg font-bold transition #{params[:category_id].to_s == cat.id.to_s ? 'bg-bush-800 text-white' : 'bg-white text-stone-700 border border-stone-200'}" %>
      <% end %>
    </div>
  </div>

  <!-- Products Table -->
  <div class="bg-white rounded-2xl border border-stone-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-stone-100 text-stone-500 uppercase text-[10px] tracking-wider border-b border-stone-200">
          <tr>
            <th class="py-3 px-4">Product Name</th>
            <th class="py-3 px-4">Department & Category</th>
            <th class="py-3 px-4">Brand</th>
            <th class="py-3 px-4">Packaging & SKUs</th>
            <th class="py-3 px-4">Retail Price</th>
            <th class="py-3 px-4 text-center">Total Stock</th>
            <th class="py-3 px-4 text-center">Status</th>
            <th class="py-3 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% @products.each do |product| %>
            <tr class="hover:bg-stone-50 transition">
              <td class="py-3 px-4">
                <div class="flex items-center gap-3">
                  <img src="<%= product.hero_image_url.presence || '/images/muchea_logo.jpg' %>" alt="" class="w-10 h-10 object-cover rounded-lg border border-stone-200">
                  <div>
                    <strong class="text-stone-900 block font-bold text-xs"><%= product.name %></strong>
                    <span class="text-stone-400 text-[10px]"><%= product.variants.count %> packaged options</span>
                  </div>
                </div>
              </td>
              <td class="py-3 px-4">
                <span class="block font-semibold text-stone-800"><%= product.category.name %></span>
                <span class="text-stone-400 text-[10px]"><%= product.category.department %></span>
              </td>
              <td class="py-3 px-4 font-bold text-stone-700"><%= product.brand %></td>
              <td class="py-3 px-4 text-stone-600">
                <% product.variants.each do |v| %>
                  <div class="text-[11px]">
                    <span class="font-medium text-stone-800"><%= v.name %>:</span>
                    <code class="font-mono text-stone-500 text-[10px]"><%= v.sku %></code>
                  </div>
                <% end %>
              </td>
              <td class="py-3 px-4 font-black text-bush-900"><%= product.price_display %></td>
              <td class="py-3 px-4 text-center">
                <span class="inline-block px-2.5 py-0.5 rounded-lg font-black text-xs <%= product.total_stock > 10 ? 'bg-emerald-100 text-emerald-800' : (product.total_stock > 0 ? 'bg-amber-100 text-amber-800' : 'bg-rose-100 text-rose-800') %>">
                  <%= product.total_stock %>
                </span>
              </td>
              <td class="py-3 px-4 text-center">
                <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-bold <%= product.active? ? 'bg-emerald-100 text-emerald-800' : 'bg-stone-200 text-stone-600' %>">
                  <%= product.active? ? 'Active' : 'Draft' %>
                </span>
              </td>
              <td class="py-3 px-4 text-right">
                <div class="flex items-center justify-end gap-2">
                  <%= link_to "Edit", edit_admin_product_path(product), class: "px-2.5 py-1 bg-stone-100 hover:bg-stone-200 text-stone-800 rounded font-bold text-xs transition" %>
                  <%= link_to "View", product_path(product), target: "_blank", class: "px-2.5 py-1 bg-bush-50 hover:bg-bush-100 text-bush-800 rounded font-bold text-xs transition" %>
                  <%= button_to "Delete", admin_product_path(product), method: :delete, data: { turbo_confirm: "Are you sure you want to delete '#{product.name}'?" }, class: "px-2 py-1 bg-rose-50 hover:bg-rose-100 text-rose-700 rounded font-bold text-xs transition cursor-pointer" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
