<% content_for :title, "Order ##{@order.order_number}" %>

<div class="space-y-6">
  <!-- Top Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <nav class="text-xs text-stone-500 mb-1">
        <%= link_to "← Back to All Orders", admin_orders_path, class: "hover:underline text-bush-800 font-semibold" %>
      </nav>
      <div class="flex items-center gap-3">
        <h1 class="text-2xl font-black text-bush-900 tracking-tight">Order #<%= @order.order_number %></h1>
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold border <%= @order.status_badge_class %>">
          <%= @order.status_label %>
        </span>
      </div>
      <p class="text-xs text-stone-500 mt-1">Placed on <%= @order.created_at.strftime("%A, %d %B %Y at %I:%M %p") %> • Tracking Code: <strong class="font-mono text-stone-800"><%= @order.tracking_code %></strong></p>
    </div>

    <!-- Quick Status Advance & Packing Slip Actions -->
    <div class="flex items-center gap-3">
      <%= link_to packing_slip_admin_order_path(@order), target: "_blank", class: "px-3.5 py-2 bg-white text-stone-800 border border-stone-300 rounded-lg text-xs font-bold hover:bg-stone-50 transition shadow-sm flex items-center gap-1.5" do %>
        <span>🖨️ Print Warehouse Packing Slip</span>
      <% end %>

      <% unless @order.status == 'delivered' || @order.status == 'cancelled' %>
        <%= button_to "Advance to Next Status →", advance_status_admin_order_path(@order), method: :patch, class: "px-4 py-2 bg-bush-800 hover:bg-bush-900 text-white rounded-lg text-xs font-bold transition shadow cursor-pointer" %>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Left Column: Items & Fulfillment -->
    <div class="lg:col-span-8 space-y-6">
      <!-- Line Items Card -->
      <div class="bg-white rounded-2xl border border-stone-200 shadow-sm overflow-hidden">
        <div class="p-5 bg-stone-50 border-b border-stone-200 flex justify-between items-center text-xs font-bold text-stone-700">
          <span>Picking Manifest</span>
          <span><%= @order.items.count %> line items</span>
        </div>

        <div class="divide-y divide-stone-100">
          <% @order.items.each do |item| %>
            <div class="p-4 flex items-center justify-between text-xs">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-bush-50 text-bush-900 font-bold flex items-center justify-center border border-bush-200">
                  <%= item.quantity %>x
                </div>
                <div>
                  <strong class="text-stone-900 text-sm block"><%= item.product_variant.product.name %></strong>
                  <span class="text-stone-500 font-medium">Variant: <%= item.product_variant.name %> • SKU: <code class="font-mono"><%= item.product_variant.sku %></code></span>
                </div>
              </div>
              <div class="text-right">
                <span class="block font-black text-stone-900 text-sm"><%= item.formatted_total %></span>
                <span class="text-[10px] text-stone-400"><%= item.quantity %> @ AU$ <%= format('%.2f', item.unit_price_cents / 100.0) %></span>
              </div>
            </div>
          <% end %>
        </div>

        <div class="p-5 bg-stone-50 border-t border-stone-200 flex justify-end">
          <div class="w-64 space-y-1.5 text-xs">
            <div class="flex justify-between text-stone-600">
              <span>Subtotal:</span>
              <span class="font-bold text-stone-900"><%= format_aud(@order.subtotal_cents) %></span>
            </div>
            <div class="flex justify-between text-stone-600">
              <span>Delivery Fee:</span>
              <span class="font-bold text-stone-900"><%= @order.delivery_fee_cents.zero? ? 'FREE' : format_aud(@order.delivery_fee_cents) %></span>
            </div>
            <div class="flex justify-between text-stone-500 text-[11px]">
              <span>Included GST (10%):</span>
              <span><%= format_aud(@order.gst_cents) %></span>
            </div>
            <div class="flex justify-between text-sm font-black text-stone-900 pt-2 border-t border-stone-200">
              <span>Total Paid:</span>
              <span><%= @order.formatted_total %></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Update Order Attributes Form -->
      <div class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm space-y-4">
        <h3 class="text-sm font-bold text-bush-900 border-b border-stone-100 pb-2">Logistics & Driver Notes</h3>
        <%= form_with model: [:admin, @order], local: true, class: "space-y-4 text-xs" do |f| %>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block font-bold text-stone-700 mb-1">Carrier / Truck Allocation</label>
              <%= f.text_field :carrier_name, class: "w-full px-3 py-2 rounded-lg border border-stone-300 bg-stone-50 focus:outline-none" %>
            </div>
            <div>
              <label class="block font-bold text-stone-700 mb-1">Status Override</label>
              <%= f.select :status, Order::STATUSES.map { |s| [s.titleize, s] }, {}, class: "w-full px-3 py-2 rounded-lg border border-stone-300 bg-stone-50 focus:outline-none" %>
            </div>
          </div>

          <div>
            <label class="block font-bold text-stone-700 mb-1">Delivery / Paddock Instructions</label>
            <%= f.text_area :delivery_notes, rows: 2, class: "w-full px-3 py-2 rounded-lg border border-stone-300 bg-stone-50 focus:outline-none" %>
          </div>

          <%= f.submit "Save Order Updates", class: "px-4 py-2 bg-bush-800 text-white font-bold rounded-lg text-xs hover:bg-bush-900 transition cursor-pointer" %>
        <% end %>
      </div>
    </div>

    <!-- Right Column: Customer Info -->
    <div class="lg:col-span-4 space-y-6">
      <div class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm space-y-4 text-xs">
        <h3 class="text-sm font-bold text-bush-900 border-b border-stone-100 pb-2">Customer & Destination</h3>

        <div>
          <span class="block text-stone-400 uppercase text-[10px] font-bold">Customer Name</span>
          <strong class="text-stone-900 text-sm block mt-0.5"><%= @order.customer_name %></strong>
          <p class="text-stone-600 mt-0.5"><%= @order.customer_email %></p>
          <p class="text-stone-600"><%= @order.customer_phone %></p>
        </div>

        <div class="pt-3 border-t border-stone-100">
          <span class="block text-stone-400 uppercase text-[10px] font-bold">Fulfillment Type</span>
          <p class="font-bold text-stone-900 mt-0.5"><%= @order.fulfillment_type == 'pickup' ? 'Drive-Thru Warehouse Loading' : 'Farm / Stable Delivery Run' %></p>
          <% if @order.delivery? %>
            <p class="text-stone-600 mt-1"><%= @order.delivery_address %></p>
            <p class="text-stone-600"><%= @order.suburb %> WA <%= @order.postcode %></p>
          <% end %>
        </div>

        <div class="pt-3 border-t border-stone-100">
          <span class="block text-stone-400 uppercase text-[10px] font-bold">Payment Details</span>
          <p class="text-stone-700 mt-0.5">Method: <strong><%= @order.payment_method %></strong></p>
          <p class="text-stone-700">Status: <strong class="text-emerald-700 uppercase font-black"><%= @order.payment_status %></strong></p>
          <p class="text-[10px] font-mono text-stone-400">Ref: <%= @order.stripe_payment_intent_id %></p>
        </div>

        <div class="pt-3 border-t border-stone-100">
          <%= link_to "View Customer Tax Invoice →", tax_invoice_path(@order.order_number), target: "_blank", class: "text-bush-800 font-bold hover:underline" %>
        </div>
      </div>
    </div>
  </div>
</div>

