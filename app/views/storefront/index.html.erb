<!-- Hero Section (Clean, Modern Australian Rural E-Commerce) -->
<section class="relative bg-gradient-to-br from-bush-900 via-bush-800 to-stone-900 text-white overflow-hidden py-14 lg:py-20 border-b-4 border-wheat-500">
  <div class="absolute inset-0 opacity-10 bg-repeat" style="background-image: radial-gradient(#d49b28 1px, transparent 1px); background-size: 28px 28px;"></div>
  
  <div class="max-w-7xl mx-auto px-4 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
      <!-- Left Column: Primary Proposition -->
      <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
        <div class="inline-flex items-center gap-2 bg-bush-800/90 border border-bush-600 px-3.5 py-1.5 rounded-full text-xs font-semibold">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span class="text-emerald-300 font-bold">🟢 Live Now:</span>
          <span class="text-stone-200">Stockfeed, Grains &amp; Oaten Hay Deliveries</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight leading-tight">
          Trusted Animal Feeds &amp; Nutrition, <br>
          <span class="text-wheat-500 font-serif italic">Delivered Direct to Your Gate.</span>
        </h1>

        <p class="text-stone-300 text-sm sm:text-base max-w-2xl mx-auto lg:mx-0 leading-relaxed font-normal">
          Your local Western Australian animal care and feed specialist in Muchea. Supplying horse owners, hobby farmers, pastoralists, and working dogs with weekly truck runs and free warehouse drive-thru bag loading.
        </p>

        <!-- Phase Status Pill -->
        <div class="p-3 bg-bush-950/70 border border-bush-700/80 rounded-xl text-xs text-stone-300 max-w-xl mx-auto lg:mx-0 flex items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <span class="text-emerald-400 font-bold">Phase 1 (Live):</span>
            <span>Equine, Hay, Cattle, Poultry &amp; Pet Feeds</span>
          </div>
          <span class="text-stone-500">|</span>
          <div class="flex items-center gap-2 text-wheat-500 font-semibold">
            <span>Phase 2:</span>
            <span>Hardware &amp; Fencing Soon</span>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3.5 pt-2">
          <%= link_to products_path(department: "Stockfeed & Animal Nutrition"), class: "w-full sm:w-auto px-7 py-3.5 bg-wheat-500 hover:bg-wheat-600 text-bush-900 font-extrabold rounded-xl shadow-lg transition text-center flex items-center justify-center gap-2 group text-sm" do %>
            <span>Shop Live Feeds &amp; Hay</span>
            <svg class="w-4 h-4 group-hover:translate-x-1 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          <% end %>

          <%= link_to delivery_schedule_path, class: "w-full sm:w-auto px-6 py-3.5 bg-white/10 hover:bg-white/15 text-white font-bold rounded-xl border border-white/20 transition text-center text-sm" do %>
            View Delivery Timetable
          <% end %>

          <%= link_to drive_thru_pickup_path, class: "w-full sm:w-auto text-xs text-stone-300 hover:text-white underline text-center" do %>
            Drive-Thru Bag Loading →
          <% end %>
        </div>

        <!-- Trust Mini Checklist -->
        <div class="pt-4 border-t border-bush-700/60 flex flex-wrap items-center justify-center lg:justify-start gap-6 text-xs text-stone-300">
          <div class="flex items-center gap-2">
            <%= svg_icon("truck", css_class: "w-4 h-4 text-wheat-500") %>
            <span>Local WA Farm Truck Runs</span>
          </div>
          <div class="flex items-center gap-2">
            <%= svg_icon("check", css_class: "w-4 h-4 text-wheat-500") %>
            <span>Drive-Thru Bag Loading (We Load Ute/Trailer)</span>
          </div>
          <div class="flex items-center gap-2">
            <%= svg_icon("shield", css_class: "w-4 h-4 text-wheat-500") %>
            <span>ABN 48 619 284 921 (10% GST Inc.)</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Clean Brand Signboard Badge -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="relative max-w-sm w-full bg-bush-950/90 p-6 rounded-3xl border-2 border-bush-700 shadow-2xl backdrop-blur text-center">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-red-600 text-white text-[11px] font-black uppercase tracking-wider px-3.5 py-0.5 rounded-full shadow">
            Direct from Muchea WA
          </div>
          
          <img src="/images/muchea_logo.jpg" alt="Muchea Stock Feed & Hardware Official Logo" class="w-44 h-44 mx-auto object-cover rounded-2xl border-2 border-red-700 shadow-xl mb-4" width="176" height="176" style="width: 176px; height: 176px; max-width: 176px; max-height: 176px; object-fit: cover;">

          <h2 class="text-xl font-black text-white uppercase tracking-tight">
            <span class="text-red-500">MUCHEA</span> STOCK FEED
          </h2>
          <p class="text-xs font-bold text-stone-300 uppercase tracking-wider">&amp; HARDWARE</p>
          <p class="text-xs font-serif italic text-wheat-500 mt-1">"For Farms, Homes &amp; Life"</p>

          <div class="mt-4 p-3.5 bg-bush-900/90 rounded-2xl border border-bush-800 text-xs text-left space-y-2">
            <div class="flex justify-between items-center text-stone-300">
              <span>Drive-Thru Bay Loading:</span>
              <strong class="text-emerald-400 font-bold">Open Daily</strong>
            </div>
            <div class="flex justify-between items-center text-stone-300">
              <span>Next Delivery Run:</span>
              <strong class="text-wheat-500 font-bold">Chittering / Bullsbrook (Mon)</strong>
            </div>
            <div class="flex justify-between items-center text-stone-300">
              <span>Live Stock Status:</span>
              <strong class="text-white font-bold">All Feeds, Chaff &amp; Hay</strong>
            </div>
          </div>

          <a href="tel:0895718840" class="mt-4 block w-full py-2.5 bg-red-700 hover:bg-red-800 text-white text-xs font-bold rounded-xl transition uppercase tracking-wider shadow">
            Call Warehouse Counter: (08) 9571 8840
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 4 Key Services Bar (Clean, Modern Cards like All Things Stock) -->
<section class="bg-stone-50 border-b border-stone-200 py-8">
  <div class="max-w-7xl mx-auto px-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    <div class="bg-white p-5 rounded-2xl border border-stone-200 shadow-xs flex items-start gap-4 hover:shadow-sm transition">
      <div class="w-12 h-12 rounded-xl bg-bush-50 text-bush-800 flex items-center justify-center flex-shrink-0 border border-bush-100">
        <%= svg_icon("truck", css_class: "w-6 h-6 text-bush-800") %>
      </div>
      <div>
        <h3 class="text-sm font-bold text-stone-900">Local Farm Deliveries</h3>
        <p class="text-xs text-stone-500 mt-1 leading-relaxed">Dedicated weekly truck routes across Muchea, Chittering, Bullsbrook, Gingin &amp; Bindoon.</p>
      </div>
    </div>

    <div class="bg-white p-5 rounded-2xl border border-stone-200 shadow-xs flex items-start gap-4 hover:shadow-sm transition">
      <div class="w-12 h-12 rounded-xl bg-wheat-50 text-wheat-600 flex items-center justify-center flex-shrink-0 border border-wheat-100">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
      </div>
      <div>
        <h3 class="text-sm font-bold text-stone-900">Drive-Thru Bag Loading</h3>
        <p class="text-xs text-stone-500 mt-1 leading-relaxed">Reverse your ute or float into Bay 1 or 2. Our warehouse crew load your bags and bales for you.</p>
      </div>
    </div>

    <div class="bg-white p-5 rounded-2xl border border-stone-200 shadow-xs flex items-start gap-4 hover:shadow-sm transition">
      <div class="w-12 h-12 rounded-xl bg-red-50 text-red-600 flex items-center justify-center flex-shrink-0 border border-red-100">
        <%= svg_icon("shield", css_class: "w-6 h-6 text-red-600") %>
      </div>
      <div>
        <h3 class="text-sm font-bold text-stone-900">Wholesale Bulk Tiers</h3>
        <p class="text-xs text-stone-500 mt-1 leading-relaxed">Save up to 10% on 40-bag pallets and 1-tonne bulk bags for commercial studs &amp; stations.</p>
      </div>
    </div>

    <div class="bg-white p-5 rounded-2xl border border-stone-200 shadow-xs flex items-start gap-4 hover:shadow-sm transition">
      <div class="w-12 h-12 rounded-xl bg-stone-100 text-stone-700 flex items-center justify-center flex-shrink-0 border border-stone-200">
        <%= svg_icon("check", css_class: "w-6 h-6 text-stone-700") %>
      </div>
      <div>
        <h3 class="text-sm font-bold text-stone-900">WA Grown &amp; Trusted</h3>
        <p class="text-xs text-stone-500 mt-1 leading-relaxed">Locally sourced Western Australian grains, oaten hay rolls, clean chaff, and trusted national feeds.</p>
      </div>
    </div>
  </div>
</section>

<!-- Visual Department Grid: Shop By Animal & Feed Category -->
<section class="max-w-7xl mx-auto px-4 py-12">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 pb-3 border-b border-stone-200 gap-4">
    <div>
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        <span class="text-xs font-bold text-emerald-700 uppercase tracking-wider">Live &amp; Ready for Delivery or Pickup</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-black text-bush-900 mt-1">Shop Animal Feeds by Department</h2>
    </div>
    <div class="text-xs text-stone-500">
      Need feeding advice? Call the counter: <strong class="text-stone-900">(08) 9571 8840</strong>
    </div>
  </div>

  <!-- Live Feeds Categories Grid -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
    <% @live_categories.each do |cat| %>
      <%= link_to category_path(cat), class: "group bg-white p-5 rounded-2xl border border-stone-200 shadow-xs hover:shadow-md hover:border-bush-700 transition flex flex-col justify-between text-center" do %>
        <div>
          <div class="w-14 h-14 rounded-2xl bg-bush-50 group-hover:bg-bush-100 text-bush-800 flex items-center justify-center mx-auto mb-3 transition">
            <%= svg_icon(cat.icon, css_class: "w-7 h-7 text-bush-800") %>
          </div>
          <span class="inline-block px-2 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider bg-emerald-100 text-emerald-800 mb-1">
            Live In Stock
          </span>
          <h3 class="text-sm font-bold text-stone-900 group-hover:text-bush-800 transition leading-snug">
            <%= cat.name %>
          </h3>
          <p class="text-[11px] text-stone-500 mt-1 line-clamp-2 leading-relaxed">
            <%= cat.description %>
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-stone-100 text-xs font-bold text-bush-800 group-hover:text-red-700 transition">
          <span><%= cat.products.count %> Products →</span>
        </div>
      <% end %>
    <% end %>
  </div>
</section>

<!-- Featured Live Stockfeed Products Grid -->
<section class="bg-stone-100 py-12 border-y border-stone-200">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
      <div>
        <span class="text-xs font-bold text-emerald-700 uppercase tracking-widest flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          Available for Immediate Order
        </span>
        <h2 class="text-2xl sm:text-3xl font-black text-bush-900 mt-1">Popular Stockfeeds &amp; Prime Hay</h2>
      </div>
      <%= link_to "View All Live Feeds (#{Product.live.count} items) →", products_path(department: "Stockfeed & Animal Nutrition"), class: "text-xs font-bold text-bush-800 hover:text-red-700 underline" %>
    </div>

    <!-- Products Grid (Clean Cards like All Things Stock) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <% @featured_feed_products.each do |product| %>
        <div class="bg-white rounded-2xl border border-stone-200 overflow-hidden shadow-xs hover:shadow-md transition flex flex-col justify-between group">
          <div>
            <!-- Image Area -->
            <div class="relative h-52 bg-stone-50 overflow-hidden">
              <img src="<%= product.hero_image_url.presence || '/images/muchea_logo.jpg' %>" alt="<%= product.name %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
              <div class="absolute top-2.5 left-2.5">
                <span class="bg-bush-900 text-white text-[10px] font-bold uppercase px-2.5 py-0.5 rounded-full shadow">
                  <%= product.brand %>
                </span>
              </div>
              <div class="absolute top-2.5 right-2.5">
                <span class="bg-emerald-600 text-white text-[9px] font-bold uppercase px-2 py-0.5 rounded shadow">
                  Live
                </span>
              </div>
            </div>

            <!-- Body -->
            <div class="p-4">
              <span class="text-[10px] font-bold text-stone-400 uppercase tracking-wider"><%= product.category.name %></span>
              <h3 class="text-sm font-bold text-stone-900 mt-1 line-clamp-2 hover:text-bush-800">
                <%= link_to product.name, product_path(product) %>
              </h3>
              <p class="text-xs text-stone-500 mt-1 line-clamp-2"><%= product.short_description %></p>
            </div>
          </div>

          <!-- Bottom Price & CTA -->
          <div class="p-4 pt-0 border-t border-stone-100 mt-2">
            <div class="flex items-baseline justify-between mb-3 pt-2">
              <div>
                <span class="block text-base font-black text-bush-900">
                  <%= product.price_display %>
                </span>
                <span class="block text-[10px] text-stone-400 font-medium">AUD inc. 10% GST</span>
              </div>
              <span class="text-[11px] font-bold <%= product.in_stock? ? 'text-emerald-700' : 'text-rose-600' %>">
                <%= product.in_stock? ? "In Stock (#{product.total_stock})" : "Out of Stock" %>
              </span>
            </div>

            <div class="flex items-center gap-2">
              <%= link_to "Select Packaging & Buy", product_path(product), class: "w-full py-2.5 text-center text-xs font-bold bg-bush-800 hover:bg-bush-900 text-white rounded-xl shadow-xs transition" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<!-- Phase 2: Rural Hardware & Farm Supplies Teaser / Preview -->
<section class="max-w-7xl mx-auto px-4 py-12">
  <div class="bg-gradient-to-r from-stone-900 to-bush-900 text-white rounded-3xl p-6 sm:p-10 shadow-lg border-2 border-stone-700 overflow-hidden relative">
    <div class="max-w-2xl mb-8">
      <span class="inline-block bg-amber-500 text-stone-900 text-[10px] font-black uppercase px-3 py-1 rounded-full mb-3 tracking-wider">
        Phase 2 Expansion • Coming Soon
      </span>
      <h2 class="text-2xl sm:text-3xl font-black font-sans leading-tight">
        Rural Hardware, Fencing Wire &amp; Poly Pipe
      </h2>
      <p class="text-xs sm:text-sm text-stone-300 mt-2 leading-relaxed">
        We are actively expanding our Muchea warehouse yard for Phase 2! Australian-spec Waratah Cyclone boundary fencing wire, black bitumen star pickets, Philmac rural poly fittings, and heavy concrete livestock troughs are arriving soon.
      </p>
    </div>

    <!-- Preview Items Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <% @coming_soon_hardware_products.each do |hw| %>
        <div class="bg-white/10 border border-white/15 rounded-2xl p-4 backdrop-blur flex flex-col justify-between">
          <div>
            <div class="h-28 rounded-xl overflow-hidden mb-3 bg-stone-800">
              <img src="<%= hw.hero_image_url.presence || '/images/muchea_logo.jpg' %>" alt="" class="w-full h-full object-cover opacity-85">
            </div>
            <span class="text-[9px] font-bold uppercase tracking-wider text-amber-400 block"><%= hw.brand %> • Phase 2</span>
            <h4 class="text-xs font-bold text-white mt-0.5 line-clamp-1"><%= hw.name %></h4>
            <span class="text-xs font-bold text-stone-200 mt-1 block"><%= hw.price_display %></span>
          </div>
          <div class="mt-3 pt-2 border-t border-white/10 flex items-center justify-between text-[11px]">
            <span class="text-stone-400">Arriving Soon</span>
            <%= link_to "Preview Specs →", product_path(hw), class: "text-wheat-500 font-semibold hover:underline" %>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Register Interest Box -->
    <div class="mt-6 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
      <p class="text-stone-300">
        Contractor, fencing contractor, or commercial grazier? <strong>Request advance commercial quotes for bulk wire or star picket slings.</strong>
      </p>
      <%= link_to "Register Trade Interest / Contact →", contact_path, class: "px-5 py-2.5 bg-amber-500 hover:bg-amber-600 text-stone-900 font-bold rounded-xl transition whitespace-nowrap shadow" %>
    </div>
  </div>
</section>

<!-- Weekly Delivery Schedule Table (Clean & Transparent) -->
<section class="max-w-7xl mx-auto px-4 py-8 mb-6">
  <div class="bg-white rounded-3xl border border-stone-200 shadow-sm p-6 sm:p-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-6 pb-3 border-b border-stone-100 gap-4">
      <div>
        <span class="text-xs font-bold text-red-600 uppercase tracking-widest">Local Logistics</span>
        <h2 class="text-xl sm:text-2xl font-black text-bush-900 mt-0.5">Scheduled Farm Delivery Timetable</h2>
      </div>
      <p class="text-xs text-stone-500">
        Order cut-off: <strong>3:00 PM</strong> on the working day prior to your zone's scheduled run.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% @delivery_zones.each do |zone| %>
        <div class="p-4 rounded-2xl bg-stone-50 border border-stone-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <span class="inline-block px-2.5 py-0.5 rounded text-[10px] font-extrabold uppercase tracking-wide bg-bush-800 text-wheat-500 mb-1">
              <%= zone.scheduled_days %>
            </span>
            <h4 class="text-sm font-bold text-stone-900"><%= zone.name %></h4>
            <p class="text-xs text-stone-500 mt-0.5"><%= zone.description %></p>
            <p class="text-[11px] text-stone-400 mt-0.5">Postcodes: <strong class="text-stone-700"><%= zone.postcodes %></strong></p>
          </div>
          <div class="text-left sm:text-right flex-shrink-0">
            <span class="text-base font-black text-bush-900 block"><%= zone.formatted_fee %></span>
            <% if zone.free_threshold_cents.present? %>
              <span class="text-[10px] text-emerald-700 font-bold block">Free over <%= format_aud(zone.free_threshold_cents) %></span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<!-- Drive-Thru Bag Loading Spotlight -->
<section class="max-w-7xl mx-auto px-4 py-6 mb-12">
  <div class="bg-wheat-50 border border-wheat-200 rounded-3xl p-6 sm:p-8 flex flex-col lg:flex-row items-center justify-between gap-6">
    <div class="flex items-center gap-5">
      <div class="w-16 h-16 rounded-2xl bg-wheat-500 text-bush-900 flex items-center justify-center font-black text-2xl flex-shrink-0 shadow-xs">
        Bay 1
      </div>
      <div>
        <span class="text-xs font-bold text-red-600 uppercase tracking-widest">Free Storefront Service</span>
        <h3 class="text-xl sm:text-2xl font-black text-bush-900">Warehouse Drive-Thru Bag Loading</h3>
        <p class="text-xs sm:text-sm text-stone-600 mt-1 max-w-2xl leading-relaxed">
          Order online and select "Warehouse Drive-Thru Pickup". Pull your ute, float, or farm trailer into Bay 1 or 2 at 14 Great Northern Hwy, Muchea. Our team loads your 20kg bags, bales, and feeds directly into your vehicle.
        </p>
      </div>
    </div>
    <%= link_to "Drive-Thru Details →", drive_thru_pickup_path, class: "px-6 py-3 bg-bush-800 hover:bg-bush-900 text-white font-bold text-xs rounded-xl whitespace-nowrap transition shadow" %>
  </div>
</section>
