<!DOCTYPE html>
<html lang="en-AU" class="h-full bg-stone-100">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) ? "#{yield(:title)} | Warehouse Admin" : "Muchea Warehouse Admin Portal" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              bush: {
                800: '#1e3a2f',
                900: '#142920',
                700: '#284e40',
                600: '#356352',
              },
              ochre: {
                600: '#b84a28',
                700: '#993c1f',
              }
            }
          }
        }
      }
    </script>
    <%= yield :head %>
  </head>

  <body class="min-h-full flex flex-col text-stone-800 antialiased">
    <!-- Admin Header -->
    <header class="bg-bush-900 text-white shadow-md sticky top-0 z-30">
      <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
        <div class="flex items-center gap-4">
          <%= link_to admin_root_path, class: "flex items-center gap-2.5" do %>
            <img src="/images/muchea_logo.jpg" alt="Logo" class="w-9 h-9 rounded-full border border-stone-400">
            <div>
              <span class="block text-sm font-bold uppercase tracking-wider text-white">Muchea Warehouse</span>
              <span class="block text-[10px] text-amber-400 font-semibold tracking-wide">OPERATIONS & INVENTORY ADMIN</span>
            </div>
          <% end %>

          <nav class="hidden md:flex items-center gap-1 ml-6 text-xs font-semibold">
            <%= link_to "Dashboard", admin_root_path, class: "px-3 py-1.5 rounded hover:bg-bush-800 transition #{'bg-bush-800 text-amber-400' if current_page?(admin_root_path)}" %>
            <%= link_to "Orders & Dispatch", admin_orders_path, class: "px-3 py-1.5 rounded hover:bg-bush-800 transition #{'bg-bush-800 text-amber-400' if controller_name == 'orders'}" %>
            <%= link_to "Live Inventory", admin_inventory_index_path, class: "px-3 py-1.5 rounded hover:bg-bush-800 transition #{'bg-bush-800 text-amber-400' if controller_name == 'inventory'}" %>
            <%= link_to "Products", admin_products_path, class: "px-3 py-1.5 rounded hover:bg-bush-800 transition #{'bg-bush-800 text-amber-400' if controller_name == 'products'}" %>
          </nav>
        </div>

        <div class="flex items-center gap-3">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-900 text-emerald-300 border border-emerald-700">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            Warehouse Online
          </span>
          <%= link_to "View Storefront →", root_path, target: "_blank", class: "text-xs text-stone-300 hover:text-white border border-stone-600 px-3 py-1 rounded hover:bg-bush-800 transition" %>
        </div>
      </div>
    </header>

    <!-- Flash Messages -->
    <% if flash[:notice].present? %>
      <div class="bg-emerald-600 text-white text-xs font-semibold py-2 px-4 text-center">
        <%= flash[:notice] %>
      </div>
    <% end %>
    <% if flash[:alert].present? %>
      <div class="bg-rose-600 text-white text-xs font-semibold py-2 px-4 text-center">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <!-- Admin Body Content -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 py-8">
      <%= yield %>
    </main>

    <footer class="bg-white border-t border-stone-200 py-4 text-center text-xs text-stone-500">
      Muchea Stockfeed & Hardware Pty Ltd — Internal Operations Hub • 14 Great Northern Hwy, Muchea WA 6501
    </footer>
  </body>
</html>

