<!DOCTYPE html>
<html lang="en-AU" class="h-full bg-stone-100">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) ? "#{yield(:title)} | Warehouse Admin" : "Muchea Warehouse Admin Portal" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Tailwind CSS CDN & Dynamic Global Brand Theme -->
    <script src="https://cdn.tailwindcss.com"></script>
    <%= render "shared/brand_theme" %>
    <%= yield :head %>
  </head>

  <body class="min-h-full flex flex-col text-stone-800 antialiased">
    <!-- Admin Header -->
    <header class="bg-bush-900 text-white shadow-md sticky top-0 z-30">
      <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between">
        <div class="flex items-center gap-4">
          <%= link_to admin_root_path, class: "flex items-center gap-2.5" do %>
            <img src="/images/muchea_logo.jpg" alt="Logo" class="w-9 h-9 rounded-full border border-stone-400" width="36" height="36" style="width: 36px; height: 36px; max-width: 36px; max-height: 36px; object-fit: cover;">
            <div>
              <span class="block text-sm font-bold uppercase tracking-wider text-white">Muchea Warehouse</span>
              <span class="block text-[10px] text-amber-400 font-semibold tracking-wide">OPERATIONS & INVENTORY ADMIN</span>
            </div>
          <% end %>

          <% nav_items = admin_nav_items %>
          <nav class="hidden lg:flex items-center gap-1 ml-6 text-xs font-semibold">
            <% nav_items.each do |item| %>
              <%
                desktop_classes = if item[:highlight] && item[:active]
                  "bg-amber-500 text-bush-950 font-bold"
                elsif item[:active]
                  "bg-bush-800 text-amber-400 font-bold"
                else
                  "hover:bg-bush-800"
                end
              %>
              <%= link_to (item[:desktop_label] || item[:label]), item[:path], class: "px-2.5 py-1.5 rounded transition whitespace-nowrap #{desktop_classes}" %>
            <% end %>
          </nav>
        </div>

        <div class="flex items-center gap-3">
          <% if admin_signed_in? %>
            <div class="hidden sm:flex flex-col text-right">
              <div class="flex items-center justify-end gap-1.5">
                <span class="text-xs font-bold text-white"><%= current_admin.name %></span>
                <span class="px-1.5 py-0.5 rounded text-[9px] font-black uppercase <%= current_admin.super_admin? ? 'bg-amber-400 text-bush-950' : 'bg-bush-700 text-emerald-200' %>">
                  <%= current_admin.role_name %>
                </span>
              </div>
              <span class="text-[10px] text-amber-400/90 font-mono"><%= current_admin.email %></span>
            </div>
            <%= button_to "Sign Out", admin_logout_path, method: :delete, class: "text-xs text-rose-300 hover:text-white border border-rose-800 bg-rose-950/70 hover:bg-rose-900 px-2.5 py-1 rounded transition cursor-pointer" %>
          <% end %>

          <%= link_to "Storefront ↗", root_path, target: "_blank", class: "text-xs text-stone-300 hover:text-white border border-stone-600 px-3 py-1 rounded hover:bg-bush-800 transition" %>
        </div>
      </div>

      <!-- Mobile/Tablet Secondary Nav Scroll -->
      <div class="lg:hidden bg-bush-950 px-4 py-2 flex items-center gap-2 overflow-x-auto text-xs border-t border-bush-800">
        <% nav_items.each do |item| %>
          <%
            mobile_classes = if item[:highlight] && item[:active]
              "bg-amber-500 text-bush-950 font-bold"
            elsif item[:highlight]
              "bg-amber-500/20 text-amber-300 border border-amber-500/40 font-bold"
            elsif item[:active]
              "bg-bush-800 text-amber-400 font-bold"
            else
              "text-stone-300"
            end
          %>
          <%= link_to item[:label], item[:path], class: "px-2.5 py-1 rounded whitespace-nowrap #{mobile_classes}" %>
        <% end %>
      </div>
    </header>

    <!-- Flash Messages -->
    <% if flash[:notice].present? %>
      <div class="bg-emerald-600 text-white text-xs font-semibold py-2 px-4 text-center">
        <%= flash[:notice] %>
      </div>
    <% end %>
    <% if flash[:alert].present? %>
      <div class="bg-rose-600 text-white text-xs font-semibold py-2 px-4 text-center">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <!-- Admin Body Content -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 py-8">
      <%= yield %>
    </main>

    <footer class="bg-white border-t border-stone-200 py-4 text-center text-xs text-stone-500">
      Muchea Stockfeed & Hardware Pty Ltd — Internal Operations Hub • 14 Great Northern Hwy, Muchea WA 6501
    </footer>
  </body>
</html>

