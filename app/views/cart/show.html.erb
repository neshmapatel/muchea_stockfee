<% content_for :title, "Your Cart | Muchea Stockfeed & Hardware" %>

<div class="bg-bush-900 text-white py-8 border-b-4 border-wheat-500">
  <div class="max-w-7xl mx-auto px-4">
    <h1 class="text-2xl sm:text-4xl font-black font-serif-brand">Your Rural Supplies Cart</h1>
    <p class="text-xs sm:text-sm text-stone-300 mt-1">Review your animal feeds, supplements, and farm hardware before checkout.</p>
  </div>
</div>

<div class="max-w-7xl mx-auto px-4 py-10">
  <% if current_cart.empty? %>
    <div class="bg-white rounded-3xl p-12 text-center border border-stone-200 shadow-sm max-w-xl mx-auto">
      <div class="w-16 h-16 bg-stone-100 rounded-full flex items-center justify-center mx-auto mb-4 text-stone-400">
        <%= svg_icon("cart", css_class: "w-8 h-8") %>
      </div>
      <h2 class="text-xl font-bold font-serif-brand text-stone-800">Your cart is currently empty</h2>
      <p class="text-xs text-stone-500 mt-1">Ready to stock up on horse feeds, chaff, oaten hay, or fencing wire?</p>
      <%= link_to "Browse Muchea Warehouse Range →", products_path, class: "mt-6 inline-block px-6 py-3 bg-bush-800 hover:bg-bush-900 text-white font-bold text-xs rounded-xl shadow transition" %>
    </div>
  <% else %>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Left Column: Line Items -->
      <div class="lg:col-span-8 space-y-4">
        <div class="bg-white rounded-2xl border border-stone-200 shadow-sm overflow-hidden">
          <div class="p-4 bg-stone-50 border-b border-stone-200 flex items-center justify-between text-xs font-bold text-stone-600">
            <span>Product Details</span>
            <span>Subtotal</span>
          </div>

          <div class="divide-y divide-stone-100">
            <% current_cart.items.each do |item| %>
              <div class="p-4 sm:p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                <div class="flex items-center gap-4">
                  <img src="<%= item[:product].hero_image_url.presence || '/images/muchea_logo.jpg' %>" alt="<%= item[:product].name %>" class="w-16 h-16 object-cover rounded-xl border border-stone-200 flex-shrink-0">
                  <div>
                    <span class="text-[10px] uppercase font-bold text-stone-400"><%= item[:product].brand %></span>
                    <h3 class="text-sm font-bold text-stone-900 leading-snug">
                      <%= link_to item[:product].name, product_path(item[:product]), class: "hover:text-bush-800" %>
                    </h3>
                    <p class="text-xs text-stone-500 font-medium mt-0.5">
                      Size: <strong class="text-stone-800"><%= item[:variant].name %></strong> • SKU: <%= item[:variant].sku %>
                    </p>
                    <span class="text-xs font-bold text-bush-900 mt-1 block">
                      <%= item[:variant].formatted_price %> each (inc. GST)
                    </span>
                  </div>
                </div>

                <div class="flex items-center justify-between sm:justify-end gap-6 w-full sm:w-auto pt-2 sm:pt-0 border-t sm:border-0 border-stone-100">
                  <!-- Quantity Controls -->
                  <div class="flex items-center border border-stone-300 rounded-lg overflow-hidden bg-stone-50 text-xs">
                    <%= button_to "-", update_cart_path(variant_id: item[:variant].id, quantity: item[:quantity] - 1), method: :patch, class: "px-2.5 py-1 text-stone-600 hover:bg-stone-200 font-black cursor-pointer" %>
                    <span class="px-3 py-1 font-bold text-stone-900 bg-white"><%= item[:quantity] %></span>
                    <%= button_to "+", update_cart_path(variant_id: item[:variant].id, quantity: item[:quantity] + 1), method: :patch, class: "px-2.5 py-1 text-stone-600 hover:bg-stone-200 font-black cursor-pointer" %>
                  </div>

                  <!-- Line Total -->
                  <div class="text-right min-w-[90px]">
                    <span class="block text-sm font-black text-bush-900"><%= format_aud(item[:total_price_cents]) %></span>
                    <%= button_to "Remove", remove_from_cart_path(item[:variant].id), method: :delete, class: "text-[11px] text-rose-600 hover:underline cursor-pointer" %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>

          <div class="p-4 bg-stone-50 border-t border-stone-200 flex justify-between items-center text-xs">
            <%= button_to "Clear Entire Cart", clear_cart_path, method: :delete, data: { turbo_confirm: "Are you sure you want to empty your cart?" }, class: "text-stone-500 hover:text-rose-600 underline cursor-pointer" %>
            <%= link_to "← Continue Shopping", products_path, class: "text-bush-800 font-bold hover:underline" %>
          </div>
        </div>

        <!-- Total Weight Notice for Rural Haulage -->
        <div class="p-4 bg-stone-100 rounded-xl border border-stone-200 text-xs text-stone-600 flex items-center justify-between">
          <span>Total Order Weight: <strong class="text-stone-900"><%= current_cart.total_weight_kg %> kg</strong></span>
          <span class="text-stone-500">Forklift assist available at warehouse & for heavy farm drops.</span>
        </div>
      </div>

      <!-- Right Column: Order Summary & Fulfillment Selection -->
      <div class="lg:col-span-4 space-y-6">
        <div class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm space-y-5">
          <h2 class="text-base font-bold text-bush-900 border-b border-stone-100 pb-3">Fulfillment & Order Summary</h2>

          <!-- Fulfillment Toggle -->
          <div>
            <label class="block text-xs font-bold text-stone-700 uppercase tracking-wider mb-2">Delivery Method</label>
            <%= form_with url: update_cart_path, method: :patch, local: true, class: "space-y-2 text-xs" do |f| %>
              <div class="grid grid-cols-2 gap-2">
                <button type="submit" name="fulfillment_type" value="delivery" class="p-3 rounded-xl border text-center font-bold transition <%= current_cart.fulfillment_type == 'delivery' ? 'bg-bush-800 text-white border-bush-800 shadow' : 'bg-stone-50 text-stone-700 border-stone-200 hover:bg-stone-100' %>">
                  🚜 Local Farm Run
                </button>
                <button type="submit" name="fulfillment_type" value="pickup" class="p-3 rounded-xl border text-center font-bold transition <%= current_cart.fulfillment_type == 'pickup' ? 'bg-bush-800 text-white border-bush-800 shadow' : 'bg-stone-50 text-stone-700 border-stone-200 hover:bg-stone-100' %>">
                  🚗 Drive-Thru (FREE)
                </button>
              </div>

              <% if current_cart.fulfillment_type == 'delivery' %>
                <div class="pt-3">
                  <label class="block text-[11px] font-bold text-stone-600 mb-1">WA Delivery Postcode</label>
                  <div class="flex gap-2">
                    <%= f.text_field :postcode, value: current_cart.postcode, placeholder: "e.g. 6084, 6501, 6503", class: "flex-1 px-3 py-1.5 rounded-lg border border-stone-300 text-xs bg-stone-50 focus:outline-none" %>
                    <%= f.submit "Update", class: "px-3 py-1.5 bg-stone-800 text-white rounded-lg text-xs font-semibold cursor-pointer" %>
                  </div>
                  <% if current_cart.delivery_zone.present? %>
                    <p class="text-[11px] text-emerald-700 font-semibold mt-1">
                      Matched: <%= current_cart.delivery_zone.name %> (<%= current_cart.delivery_zone.scheduled_days %>)
                    </p>
                  <% end %>
                </div>
              <% else %>
                <p class="text-[11px] text-stone-500 pt-1">
                  Ready within 1 hr at 14 Great Northern Hwy, Muchea. We load your ute or trailer.
                </p>
              <% end %>
            <% end %>
          </div>

          <!-- Price Breakdown -->
          <div class="space-y-2.5 text-xs pt-3 border-t border-stone-100">
            <div class="flex justify-between text-stone-600">
              <span>Subtotal (inc. GST)</span>
              <span class="font-bold text-stone-900"><%= format_aud(current_cart.subtotal_cents) %></span>
            </div>

            <div class="flex justify-between text-stone-600">
              <span>Delivery Fee</span>
              <span class="font-bold text-stone-900">
                <%= current_cart.fulfillment_type == 'pickup' ? 'FREE' : format_aud(current_cart.delivery_fee_cents) %>
              </span>
            </div>

            <div class="flex justify-between text-stone-500 text-[11px] pt-1">
              <span>Includes 10% Australian GST</span>
              <span><%= format_aud(current_cart.gst_cents) %></span>
            </div>

            <div class="flex justify-between items-baseline pt-3 border-t border-stone-200">
              <span class="text-sm font-bold text-stone-900">Total AUD</span>
              <div class="text-right">
                <span class="text-2xl font-black text-bush-900"><%= format_aud(current_cart.total_cents) %></span>
                <span class="block text-[10px] text-stone-400">AUD inc. 10% GST</span>
              </div>
            </div>
          </div>

          <!-- Checkout CTA -->
          <%= link_to "Proceed to Checkout →", checkout_path, class: "block w-full py-3.5 bg-bush-800 hover:bg-bush-900 text-white font-extrabold text-center rounded-xl shadow-md transition uppercase text-xs tracking-wider" %>

          <div class="text-[11px] text-stone-400 text-center space-y-1">
            <p>🔒 256-Bit SSL Encrypted Australian Checkout</p>
            <p>Cards, Apple Pay, Google Pay, Afterpay Accepted</p>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

