<% content_for :title, "Tracking Consignment #{@order.tracking_code} | Muchea Stockfeed & Hardware" %>

<div class="bg-bush-900 text-white py-10 border-b-4 border-wheat-500">
  <div class="max-w-4xl mx-auto px-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <nav class="text-xs text-stone-300 mb-2 flex items-center gap-1.5">
          <%= link_to "Tracking Lookup", tracking_lookup_path, class: "hover:text-wheat-500 underline" %>
          <span>/</span>
          <span class="text-wheat-500 font-mono font-bold"><%= @order.tracking_code %></span>
        </nav>
        <h1 class="text-2xl sm:text-4xl font-black font-serif-brand">Consignment Tracking</h1>
        <p class="text-xs text-stone-300 mt-1">Order Ref: <strong class="font-mono text-white"><%= @order.order_number %></strong> • Destination: <%= @order.suburb %> WA</p>
      </div>

      <div class="sm:text-right">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase <%= @order.status_badge_class %>">
          <%= @order.status_label %>
        </span>
      </div>
    </div>
  </div>
</div>

<div class="max-w-4xl mx-auto px-4 py-10 space-y-8">
  <!-- Interactive Visual Stepper -->
  <div class="bg-white p-6 sm:p-8 rounded-3xl border border-stone-200 shadow-sm">
    <h2 class="text-sm font-bold uppercase tracking-wider text-stone-400 mb-6">Fulfillment Progress</h2>

    <div class="grid grid-cols-4 gap-2 relative">
      <!-- Step 1 -->
      <div class="text-center">
        <div class="w-10 h-10 rounded-full mx-auto flex items-center justify-center font-bold text-xs <%= @order.step_number >= 1 ? 'bg-bush-800 text-white shadow' : 'bg-stone-100 text-stone-400' %>">
          1
        </div>
        <span class="block text-xs font-bold text-stone-900 mt-2">Order Confirmed</span>
        <span class="block text-[10px] text-stone-400"><%= @order.created_at.strftime("%I:%M %p") %></span>
      </div>

      <!-- Step 2 -->
      <div class="text-center">
        <div class="w-10 h-10 rounded-full mx-auto flex items-center justify-center font-bold text-xs <%= @order.step_number >= 2 ? 'bg-bush-800 text-white shadow' : 'bg-stone-100 text-stone-400' %>">
          2
        </div>
        <span class="block text-xs font-bold text-stone-900 mt-2">Packing</span>
        <span class="block text-[10px] text-stone-400">Muchea Warehouse</span>
      </div>

      <!-- Step 3 -->
      <div class="text-center">
        <div class="w-10 h-10 rounded-full mx-auto flex items-center justify-center font-bold text-xs <%= @order.step_number >= 3 ? 'bg-bush-800 text-white shadow' : 'bg-stone-100 text-stone-400' %>">
          3
        </div>
        <span class="block text-xs font-bold text-stone-900 mt-2"><%= @order.pickup? ? "Ready at Bay" : "Dispatched" %></span>
        <span class="block text-[10px] text-stone-400"><%= @order.pickup? ? "Drive-Thru" : "On Farm Truck" %></span>
      </div>

      <!-- Step 4 -->
      <div class="text-center">
        <div class="w-10 h-10 rounded-full mx-auto flex items-center justify-center font-bold text-xs <%= @order.step_number >= 4 ? 'bg-emerald-600 text-white shadow' : 'bg-stone-100 text-stone-400' %>">
          ✓
        </div>
        <span class="block text-xs font-bold text-stone-900 mt-2"><%= @order.pickup? ? "Collected" : "Delivered" %></span>
        <span class="block text-[10px] text-stone-400">Paddock / Shed</span>
      </div>
    </div>
  </div>

  <!-- Carrier & Driver Details -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm space-y-3 text-xs">
      <h3 class="font-bold text-stone-900 text-sm border-b border-stone-100 pb-2">Logistics & Carrier</h3>
      <div class="space-y-2 text-stone-600">
        <p><strong>Carrier:</strong> <%= @order.carrier_name %></p>
        <p><strong>Tracking Number:</strong> <span class="font-mono text-stone-900 font-bold"><%= @order.tracking_code %></span></p>
        <p><strong>Fulfillment Mode:</strong> <%= @order.fulfillment_type == 'pickup' ? 'Warehouse Drive-Thru Bag Loading' : 'Dedicated WA Rural Delivery Run' %></p>
        <p><strong>Estimated Completion:</strong> <%= @order.estimated_delivery_at&.strftime("%A, %d %B %Y around %I:%M %p") || "Scheduled this week" %></p>
      </div>
    </div>

    <div class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm space-y-3 text-xs">
      <h3 class="font-bold text-stone-900 text-sm border-b border-stone-100 pb-2">Destination / Notes</h3>
      <div class="space-y-2 text-stone-600">
        <p><strong>Customer:</strong> <%= @order.customer_name %></p>
        <% if @order.delivery? %>
          <p><strong>Delivery Address:</strong> <%= @order.delivery_address %>, <%= @order.suburb %> WA <%= @order.postcode %></p>
        <% else %>
          <p><strong>Collection Bay:</strong> 14 Great Northern Highway, Muchea WA 6501</p>
        <% end %>
        <% if @order.delivery_notes.present? %>
          <p><strong>Gate / Paddock Notes:</strong> <span class="italic text-stone-800"><%= @order.delivery_notes %></span></p>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Items in Consignment -->
  <div class="bg-white rounded-2xl border border-stone-200 shadow-sm overflow-hidden">
    <div class="p-4 bg-stone-50 border-b border-stone-200 flex justify-between items-center text-xs font-bold text-stone-700">
      <span>Consignment Manifest</span>
      <%= link_to "View Official Tax Invoice", tax_invoice_path(@order.order_number), target: "_blank", class: "text-bush-800 underline font-normal" %>
    </div>
    <div class="p-4 divide-y divide-stone-100 text-xs">
      <% @order.items.each do |item| %>
        <div class="py-2.5 flex justify-between items-center">
          <div>
            <strong class="text-stone-900 block"><%= item.product_variant.product.name %></strong>
            <span class="text-stone-500"><%= item.quantity %>x <%= item.product_variant.name %> (SKU: <%= item.product_variant.sku %>)</span>
          </div>
          <span class="font-bold text-stone-900"><%= item.formatted_total %></span>
        </div>
      <% end %>
    </div>
  </div>
</div>

