<% content_for :title, "Manage Products & Catalog" %>

<div class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-black text-bush-900 tracking-tight">Product Catalog Management</h1>
      <p class="text-xs text-stone-500 mt-1">Configure retail stock, nutritional formulations, and pricing tiers.</p>
    </div>

    <%= link_to "Live Inventory Manager →", admin_inventory_index_path, class: "px-4 py-2 bg-bush-800 text-white rounded-lg text-xs font-bold hover:bg-bush-900 transition shadow" %>
  </div>

  <div class="bg-white rounded-2xl border border-stone-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-stone-100 text-stone-500 uppercase text-[10px] tracking-wider border-b border-stone-200">
          <tr>
            <th class="py-3 px-4">Product Name</th>
            <th class="py-3 px-4">Department & Category</th>
            <th class="py-3 px-4">Brand</th>
            <th class="py-3 px-4">Variants / Packaging</th>
            <th class="py-3 px-4">Display Price</th>
            <th class="py-3 px-4 text-center">Status</th>
            <th class="py-3 px-4 text-right">Storefront</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% @products.each do |product| %>
            <tr class="hover:bg-stone-50 transition">
              <td class="py-3 px-4">
                <div class="flex items-center gap-3">
                  <img src="<%= product.hero_image_url.presence || '/images/muchea_logo.jpg' %>" alt="" class="w-10 h-10 object-cover rounded-lg border border-stone-200">
                  <div>
                    <strong class="text-stone-900 block"><%= product.name %></strong>
                    <span class="text-stone-400 text-[10px]"><%= product.variants.count %> packaged options</span>
                  </div>
                </div>
              </td>
              <td class="py-3 px-4">
                <span class="block font-semibold text-stone-800"><%= product.category.name %></span>
                <span class="text-stone-400 text-[10px]"><%= product.category.department %></span>
              </td>
              <td class="py-3 px-4 font-bold text-stone-700"><%= product.brand %></td>
              <td class="py-3 px-4 text-stone-600">
                <%= product.variants.map(&:name).join(", ") %>
              </td>
              <td class="py-3 px-4 font-black text-bush-900"><%= product.price_display %></td>
              <td class="py-3 px-4 text-center">
                <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-bold <%= product.active? ? 'bg-emerald-100 text-emerald-800' : 'bg-stone-200 text-stone-600' %>">
                  <%= product.active? ? 'Active' : 'Draft' %>
                </span>
              </td>
              <td class="py-3 px-4 text-right">
                <%= link_to "View Storefront ↗", product_path(product), target: "_blank", class: "text-bush-800 hover:underline font-semibold" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

