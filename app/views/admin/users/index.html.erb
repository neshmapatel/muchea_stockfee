<% content_for :title, "Staff & Admin Access Management" %>

<div class="space-y-6">
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-black text-bush-900 tracking-tight">Team Accounts &amp; Role Access</h1>
      <p class="text-xs text-stone-500 mt-1">Manage Super Admins, Store Administrators, Inventory Managers, Accountants, and Warehouse Staff.</p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <% if can?(:manage_roles) %>
        <%= link_to admin_roles_path, class: "px-4 py-2 bg-white border border-stone-300 hover:bg-stone-50 text-stone-800 rounded-xl text-xs font-bold transition shadow-xs" do %>
          <span>🛡️ Manage Roles &amp; Permissions</span>
        <% end %>
      <% end %>
      <%= link_to new_admin_user_path, class: "px-4 py-2 bg-emerald-700 hover:bg-emerald-800 text-white rounded-xl text-xs font-black transition shadow flex items-center gap-1.5" do %>
        <span>➕ Add Staff / Admin User</span>
      <% end %>
    </div>
  </div>

  <!-- Search & Role Filters -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <%= form_with url: admin_users_path, method: :get, local: true, class: "flex gap-2" do |f| %>
      <%= f.text_field :q, value: params[:q], placeholder: "Search name or email...", class: "px-3 py-1.5 rounded-lg border border-stone-300 text-xs bg-white focus:outline-none w-64" %>
      <%= f.submit "Search", class: "px-3 py-1.5 bg-bush-800 text-white rounded-lg text-xs font-semibold cursor-pointer" %>
      <% if params[:q].present? || params[:role_id].present? || params[:status].present? %>
        <%= link_to "Clear", admin_users_path, class: "px-2 py-1.5 text-xs text-stone-500 hover:text-stone-800" %>
      <% end %>
    <% end %>

    <div class="flex items-center gap-2 overflow-x-auto pb-1 text-xs">
      <%= link_to "All (#{@total_users_count})", admin_users_path, class: "px-3 py-1 rounded-lg font-bold transition #{params[:role_id].blank? ? 'bg-bush-800 text-white' : 'bg-white text-stone-700 border border-stone-200'}" %>
      <% @roles.each do |r| %>
        <%= link_to "#{r.name} (#{@role_user_counts[r.id] || 0})", admin_users_path(role_id: r.id), class: "px-3 py-1 rounded-lg font-bold whitespace-nowrap transition #{params[:role_id].to_s == r.id.to_s ? 'bg-bush-800 text-white' : 'bg-white text-stone-700 border border-stone-200'}" %>
      <% end %>
    </div>
  </div>

  <!-- Staff Table -->
  <div class="bg-white rounded-2xl border border-stone-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-stone-100 text-stone-500 uppercase text-[10px] tracking-wider border-b border-stone-200">
          <tr>
            <th class="py-3 px-4">Staff Member</th>
            <th class="py-3 px-4">Assigned Role</th>
            <th class="py-3 px-4 text-center">Account Status</th>
            <th class="py-3 px-4">Last Sign In</th>
            <th class="py-3 px-4">Added By</th>
            <th class="py-3 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% @admin_users.each do |user| %>
            <tr class="hover:bg-stone-50 transition <%= 'opacity-65 bg-stone-50' unless user.active? %>">
              <td class="py-3.5 px-4">
                <div class="flex items-center gap-3">
                  <div class="w-9 h-9 rounded-full flex items-center justify-center font-black text-xs <%= user.role.is_super_admin? ? 'bg-amber-100 text-amber-900 border border-amber-300' : 'bg-bush-100 text-bush-900' %>">
                    <%= user.name.first(2).upcase %>
                  </div>
                  <div>
                    <strong class="text-stone-900 block font-bold">
                      <%= user.name %>
                      <% if user == current_admin %>
                        <span class="ml-1 text-[10px] px-1.5 py-0.5 rounded bg-stone-200 text-stone-700 font-semibold">You</span>
                      <% end %>
                    </strong>
                    <span class="text-stone-500 font-mono text-[11px]"><%= user.email %></span>
                    <% if user.phone.present? %>
                      <span class="block text-stone-400 text-[10px]"><%= user.phone %></span>
                    <% end %>
                  </div>
                </div>
              </td>

              <td class="py-3.5 px-4">
                <% if user.role.is_super_admin? %>
                  <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-black uppercase bg-amber-400 text-bush-950 shadow-xs">
                    <span>★ <%= user.role_name %></span>
                  </span>
                <% else %>
                  <span class="inline-block px-2.5 py-1 rounded-full text-[10px] font-bold bg-bush-100 text-bush-900">
                    <%= user.role_name %>
                  </span>
                <% end %>
              </td>

              <td class="py-3.5 px-4 text-center">
                <span class="inline-block px-2 py-0.5 rounded-full text-[10px] font-bold <%= user.active? ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-700' %>">
                  <%= user.active? ? 'Active' : 'Deactivated' %>
                </span>
              </td>

              <td class="py-3.5 px-4 text-stone-500 text-[11px]">
                <%= user.last_sign_in_at ? user.last_sign_in_at.strftime("%d %b %Y, %I:%M %p") : "Never signed in" %>
              </td>

              <td class="py-3.5 px-4 text-stone-500 text-[11px]">
                <%= user.created_by&.name || "System Seed" %>
              </td>

              <td class="py-3.5 px-4 text-right">
                <% if user.manageable_by?(current_admin) || (user.role.is_super_admin? && can?(:manage_super_admins)) %>
                  <div class="flex items-center justify-end gap-2">
                    <%= link_to "Edit", edit_admin_user_path(user), class: "px-2.5 py-1 bg-stone-100 hover:bg-stone-200 text-stone-800 rounded font-bold text-xs transition" %>
                    <% unless user == current_admin %>
                      <%= button_to (user.active? ? "Deactivate" : "Reactivate"),
                                    toggle_active_admin_user_path(user),
                                    method: :patch,
                                    data: { turbo_confirm: "#{user.active? ? 'Deactivate' : 'Reactivate'} #{user.name}'s access?" },
                                    class: "px-2.5 py-1 rounded font-bold text-xs cursor-pointer transition #{user.active? ? 'bg-rose-50 hover:bg-rose-100 text-rose-700' : 'bg-emerald-50 hover:bg-emerald-100 text-emerald-800'}" %>
                    <% end %>
                  </div>
                <% else %>
                  <span class="text-[10px] text-stone-400 italic">Protected Super Admin</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>

