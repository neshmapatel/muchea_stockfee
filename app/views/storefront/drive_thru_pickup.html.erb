<% content_for :title, "Warehouse Drive-Thru Bag Loading | Muchea WA" %>

<div class="bg-bush-900 text-white py-12 border-b-4 border-wheat-500">
  <div class="max-w-7xl mx-auto px-4">
    <span class="text-xs font-bold text-wheat-500 uppercase tracking-widest">Free Storefront Service</span>
    <h1 class="text-3xl sm:text-5xl font-black font-serif-brand mt-1">Warehouse Drive-Thru Bag Loading</h1>
    <p class="text-sm text-stone-300 mt-2 max-w-2xl">
      Drive your ute, trailer, or float straight into our covered drive-thru loading bays at 14 Great Northern Highway, Muchea. Save your back — our team will forklift or hand-load your order for you.
    </p>
  </div>
</div>

<div class="max-w-7xl mx-auto px-4 py-12 space-y-12">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    <div class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm text-center">
      <div class="w-12 h-12 bg-bush-50 text-bush-800 rounded-2xl flex items-center justify-center mx-auto mb-4 font-black text-lg">1</div>
      <h3 class="text-base font-bold text-stone-900 mb-2">Order Online</h3>
      <p class="text-xs text-stone-500 leading-relaxed">
        Select the feeds, hay, or hardware you need. Choose "Warehouse Drive-Thru Pickup" at checkout. There are zero pickup or handling fees.
      </p>
    </div>

    <div class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm text-center">
      <div class="w-12 h-12 bg-wheat-50 text-wheat-600 rounded-2xl flex items-center justify-center mx-auto mb-4 font-black text-lg">2</div>
      <h3 class="text-base font-bold text-stone-900 mb-2">We Pick & Prepare</h3>
      <p class="text-xs text-stone-500 leading-relaxed">
        Our warehouse team stages your order on a dedicated pallet in Bay 1 or Bay 2 within 1 hour of receiving your order.
      </p>
    </div>

    <div class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm text-center">
      <div class="w-12 h-12 bg-ochre-50 text-ochre-600 rounded-2xl flex items-center justify-center mx-auto mb-4 font-black text-lg">3</div>
      <h3 class="text-base font-bold text-stone-900 mb-2">Drive In & We Load</h3>
      <p class="text-xs text-stone-500 leading-relaxed">
        Pull into the bay, show your order number or name, and our crew will load your 20kg bags, chaff, star pickets, or pallets into your tray or trailer.
      </p>
    </div>
  </div>

  <div class="bg-stone-100 rounded-3xl p-8 border border-stone-200">
    <div class="max-w-3xl mx-auto text-center space-y-4">
      <h2 class="text-2xl font-bold font-serif-brand text-bush-900">Trading Hours for Drive-Thru Loading</h2>
      <p class="text-xs text-stone-600">No appointment necessary. Drive straight into 14 Great Northern Highway, Muchea WA 6501.</p>
      
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs font-semibold pt-4">
        <div class="bg-white p-4 rounded-xl border border-stone-200">
          <span class="block text-stone-400 uppercase text-[10px]">Monday – Friday</span>
          <span class="block text-base text-stone-900 font-bold mt-1">7:30am – 5:00pm</span>
        </div>
        <div class="bg-white p-4 rounded-xl border border-stone-200">
          <span class="block text-stone-400 uppercase text-[10px]">Saturday</span>
          <span class="block text-base text-stone-900 font-bold mt-1">8:00am – 4:00pm</span>
        </div>
        <div class="bg-white p-4 rounded-xl border border-stone-200">
          <span class="block text-stone-400 uppercase text-[10px]">Sunday</span>
          <span class="block text-base text-stone-900 font-bold mt-1">9:00am – 2:00pm</span>
        </div>
      </div>

      <div class="pt-6">
        <%= link_to "Start Shopping Now →", products_path, class: "px-6 py-3 bg-bush-800 hover:bg-bush-900 text-white font-bold text-xs rounded-xl shadow transition inline-block" %>
      </div>
    </div>
  </div>
</div>

