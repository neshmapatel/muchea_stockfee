<% content_for :title, "Role-Based Access Control (RBAC)" %>

<div class="space-y-6">
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-black text-bush-900 tracking-tight">Roles &amp; Permission Matrix</h1>
      <p class="text-xs text-stone-500 mt-1">Configure existing roles or define new custom roles for upcoming store sections and staff positions.</p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <% if can_any?(:manage_admin_users, :manage_super_admins) %>
        <%= link_to admin_users_path, class: "px-4 py-2 bg-white border border-stone-300 hover:bg-stone-50 text-stone-800 rounded-xl text-xs font-bold transition shadow-xs" do %>
          <span>← Team Accounts</span>
        <% end %>
      <% end %>
      <%= link_to new_admin_role_path, class: "px-4 py-2 bg-emerald-700 hover:bg-emerald-800 text-white rounded-xl text-xs font-black transition shadow flex items-center gap-1.5" do %>
        <span>➕ Create Custom Role</span>
      <% end %>
    </div>
  </div>

  <!-- Roles Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <% @roles.each do |role| %>
      <% assigned_count = @user_counts_by_role[role.id] || 0 %>
      <div class="bg-white rounded-3xl border <%= role.is_super_admin? ? 'border-amber-300 ring-1 ring-amber-200' : 'border-stone-200' %> shadow-sm p-6 flex flex-col justify-between space-y-5">
        <div class="space-y-4">
          <div class="flex items-start justify-between gap-3">
            <div>
              <div class="flex items-center gap-2 flex-wrap">
                <h2 class="text-base font-black text-bush-950"><%= role.name %></h2>
                <% if role.is_super_admin? %>
                  <span class="px-2 py-0.5 rounded-full text-[9px] font-black uppercase bg-amber-400 text-bush-950">★ Super Admin (Wildcard)</span>
                <% elsif role.system_role? %>
                  <span class="px-2 py-0.5 rounded-full text-[9px] font-bold uppercase bg-stone-100 text-stone-600">Core Role</span>
                <% else %>
                  <span class="px-2 py-0.5 rounded-full text-[9px] font-bold uppercase bg-sky-100 text-sky-800">Custom Role</span>
                <% end %>
              </div>
              <span class="text-[10px] font-mono text-stone-400 block mt-0.5">slug: <%= role.slug %></span>
            </div>

            <div class="text-right flex-shrink-0">
              <span class="block text-xl font-black text-bush-900"><%= assigned_count %></span>
              <span class="block text-[10px] font-bold uppercase text-stone-400"><%= "user".pluralize(assigned_count) %></span>
            </div>
          </div>

          <p class="text-xs text-stone-600 leading-relaxed"><%= role.description %></p>

          <!-- Permissions Badges -->
          <div class="pt-2 border-t border-stone-100">
            <span class="block text-[10px] font-bold uppercase tracking-wider text-stone-400 mb-2">
              <%= role.is_super_admin? ? "Full System Authority:" : "Granted Permissions (#{role.permissions.size}):" %>
            </span>
            <% if role.is_super_admin? %>
              <span class="inline-block px-2.5 py-1 rounded-lg bg-amber-50 border border-amber-200 text-amber-900 text-[11px] font-bold">
                All Current &amp; Future Permissions Enabled Automatically
              </span>
            <% elsif role.permissions.any? %>
              <div class="flex flex-wrap gap-1.5">
                <% role.permissions.each do |perm| %>
                  <% meta = Role.permission_meta(perm) %>
                  <span class="inline-block px-2 py-0.5 rounded-md bg-bush-50 text-bush-900 border border-bush-100 text-[10px] font-semibold">
                    <%= meta ? meta[:label] : perm.humanize %>
                  </span>
                <% end %>
              </div>
            <% else %>
              <span class="text-xs text-rose-600 font-semibold">No permissions assigned yet</span>
            <% end %>
          </div>
        </div>

        <div class="pt-4 border-t border-stone-100 flex items-center justify-between gap-2">
          <% if !role.is_super_admin? || current_admin.super_admin? %>
            <%= link_to "Edit Permissions", edit_admin_role_path(role), class: "px-3 py-1.5 bg-stone-100 hover:bg-stone-200 text-stone-800 rounded-xl text-xs font-bold transition" %>
          <% else %>
            <span class="text-[11px] text-stone-400 italic">Editable by Super Admins only</span>
          <% end %>

          <% if role.deletable? && assigned_count.zero? %>
            <%= button_to "Delete Role", admin_role_path(role), method: :delete, data: { turbo_confirm: "Delete custom role '#{role.name}'?" }, class: "px-3 py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-700 rounded-xl text-xs font-bold transition cursor-pointer" %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>

