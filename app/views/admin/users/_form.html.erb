<%= form_with model: [:admin, admin_user], url: admin_user.new_record? ? admin_users_path : admin_user_path(admin_user), local: true, class: "space-y-6" do |f| %>
  <% if admin_user.errors.any? %>
    <div class="p-4 bg-rose-50 border border-rose-300 rounded-2xl text-rose-800 text-xs">
      <strong class="font-bold block mb-1">Please fix the following <%= pluralize(admin_user.errors.count, "error") %>:</strong>
      <ul class="list-disc pl-5 space-y-0.5">
        <% admin_user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Profile Details -->
  <div class="bg-white rounded-3xl border border-stone-200 p-6 sm:p-8 space-y-6 shadow-sm">
    <div class="border-b border-stone-100 pb-4">
      <h2 class="text-sm font-black text-bush-900 uppercase tracking-wider">1. Staff Profile &amp; Contact</h2>
      <p class="text-xs text-stone-500 mt-0.5">Login email and display details shown in warehouse logs.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= f.label :name, "Full Name *", class: "block text-xs font-bold text-stone-700 uppercase mb-1" %>
        <%= f.text_field :name, required: true, placeholder: "e.g. Rajeshbhai Patel", class: "w-full px-3.5 py-2.5 rounded-xl border border-stone-300 text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-bush-800" %>
      </div>

      <div>
        <%= f.label :email, "Sign-In Email Address *", class: "block text-xs font-bold text-stone-700 uppercase mb-1" %>
        <%= f.email_field :email, required: true, placeholder: "staff@mucheastockfeed.com.au", class: "w-full px-3.5 py-2.5 rounded-xl border border-stone-300 text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-bush-800" %>
      </div>

      <div>
        <%= f.label :phone, "Phone / Mobile (Optional)", class: "block text-xs font-bold text-stone-700 uppercase mb-1" %>
        <%= f.text_field :phone, placeholder: "0412 345 678", class: "w-full px-3.5 py-2.5 rounded-xl border border-stone-300 text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-bush-800" %>
      </div>

      <div class="flex items-center pt-5">
        <label class="flex items-center gap-2.5 text-xs font-bold text-stone-800 cursor-pointer">
          <%= f.check_box :active, class: "w-4 h-4 rounded text-emerald-700 focus:ring-emerald-700", disabled: (admin_user == current_admin) %>
          <span>Account Active (Allowed to Sign In)</span>
        </label>
        <% if admin_user == current_admin %>
          <span class="ml-2 text-[10px] text-stone-400">(Cannot disable self)</span>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Role Assignment -->
  <div class="bg-white rounded-3xl border border-stone-200 p-6 sm:p-8 space-y-5 shadow-sm">
    <div class="border-b border-stone-100 pb-4 flex items-center justify-between">
      <div>
        <h2 class="text-sm font-black text-bush-900 uppercase tracking-wider">2. Role &amp; Authority Assignment *</h2>
        <p class="text-xs text-stone-500 mt-0.5">Select the role defining which warehouse, catalog, financial, or admin controls this user can access.</p>
      </div>
      <% if can?(:manage_roles) %>
        <%= link_to "Customize Roles →", admin_roles_path, class: "text-xs font-bold text-bush-800 hover:underline whitespace-nowrap" %>
      <% end %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% assignable_roles.each do |role| %>
        <label class="relative flex items-start gap-3 p-4 rounded-2xl border-2 cursor-pointer transition hover:border-bush-600 has-[:checked]:border-bush-800 has-[:checked]:bg-bush-50/50 border-stone-200">
          <%= f.radio_button :role_id, role.id, class: "mt-0.5 text-bush-800 focus:ring-bush-800", required: true %>
          <div class="flex-1">
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-black text-stone-900"><%= role.name %></span>
              <% if role.is_super_admin? %>
                <span class="text-[9px] font-black uppercase px-2 py-0.5 rounded-full bg-amber-400 text-bush-950">Unrestricted ★</span>
              <% else %>
                <span class="text-[10px] font-bold text-stone-400"><%= role.permissions.size %> permissions</span>
              <% end %>
            </div>
            <p class="text-[11px] text-stone-500 mt-1 leading-relaxed"><%= role.description %></p>
          </div>
        </label>
      <% end %>
    </div>
  </div>

  <!-- Password -->
  <div class="bg-white rounded-3xl border border-stone-200 p-6 sm:p-8 space-y-5 shadow-sm">
    <div class="border-b border-stone-100 pb-4">
      <h2 class="text-sm font-black text-bush-900 uppercase tracking-wider">3. Password Credentials</h2>
      <p class="text-xs text-stone-500 mt-0.5">
        <%= admin_user.new_record? ? "Minimum 6 characters (8+ recommended)." : "Leave blank to keep the existing password unchanged." %>
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= f.label :password, (admin_user.new_record? ? "Password *" : "New Password (Optional)"), class: "block text-xs font-bold text-stone-700 uppercase mb-1" %>
        <%= f.password_field :password, required: admin_user.new_record?, autocomplete: "new-password", placeholder: "Enter password", class: "w-full px-3.5 py-2.5 rounded-xl border border-stone-300 text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-bush-800" %>
      </div>

      <div>
        <%= f.label :password_confirmation, (admin_user.new_record? ? "Confirm Password *" : "Confirm New Password"), class: "block text-xs font-bold text-stone-700 uppercase mb-1" %>
        <%= f.password_field :password_confirmation, required: admin_user.new_record?, autocomplete: "new-password", placeholder: "Repeat password", class: "w-full px-3.5 py-2.5 rounded-xl border border-stone-300 text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-bush-800" %>
      </div>
    </div>
  </div>

  <div class="flex items-center justify-end gap-3 pt-2">
    <%= link_to "Cancel", admin_users_path, class: "px-5 py-2.5 rounded-xl text-xs font-bold text-stone-600 hover:bg-stone-200 transition" %>
    <%= f.submit admin_user.new_record? ? "Create Admin / Staff Account ✓" : "Save Account Changes ✓", class: "px-6 py-2.5 bg-bush-800 hover:bg-bush-900 text-white text-xs font-black rounded-xl shadow cursor-pointer transition" %>
  </div>
<% end %>
