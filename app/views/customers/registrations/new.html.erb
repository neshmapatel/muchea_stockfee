<% content_for :title, "Activate Member Account | Muchea Stockfeed & Hardware" %>

<div class="bg-brand-dark text-white py-10 border-b-2 border-brand-primary">
  <div class="max-w-4xl mx-auto px-4 text-center">
    <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-widest bg-brand-primary/20 text-brand-accent border border-brand-primary/40 mb-3">
      Wholesale &amp; Member Pricing Access
    </span>
    <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">
      Activate Your Account to View Prices
    </h1>
    <p class="text-sm text-stone-300 mt-2 max-w-2xl mx-auto leading-relaxed">
      To protect pastoral and commercial trade pricing, live product rates and online checkout are reserved for registered rural members. Complete your profile below for shed approval.
    </p>
  </div>
</div>

<div class="max-w-2xl mx-auto px-4 py-12">
  <div class="bg-white rounded-2xl border border-stone-200 shadow-sm p-6 sm:p-10">
    <div class="flex items-center gap-3 pb-6 border-b border-stone-100 mb-6">
      <div class="w-10 h-10 rounded-full bg-brand-primary text-white flex items-center justify-center flex-shrink-0 font-black">
        1
      </div>
      <div>
        <h2 class="text-lg font-bold text-stone-900">Member Registration &amp; Contact Details</h2>
        <p class="text-xs text-stone-500">Upon profile completion, a verification request is automatically sent to our Super Admin.</p>
      </div>
    </div>

    <%= form_with model: @customer, url: customer_register_path, method: :post, local: true, class: "space-y-6 text-xs" do |f| %>
      <% if @customer.errors.any? %>
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-xs space-y-1">
          <strong class="font-bold block">Please fix the following issues:</strong>
          <ul class="list-disc list-inside">
            <% @customer.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Personal Info -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :first_name, "First Name *", class: "block font-bold text-stone-700 uppercase tracking-wider mb-1" %>
          <%= f.text_field :first_name, required: true, placeholder: "e.g. Murray", class: "w-full px-3.5 py-2.5 rounded-xl border border-stone-300 bg-stone-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-primary text-xs font-semibold" %>
        </div>
        <div>
          <%= f.label :last_name, "Last Name *", class: "block font-bold text-stone-700 uppercase tracking-wider mb-1" %>
          <%= f.text_field :last_name, required: true, placeholder: "e.g. Campbell", class: "w-full px-3.5 py-2.5 rounded-xl border border-stone-300 bg-stone-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-primary text-xs font-semibold" %>
        </div>
      </div>

      <!-- Contact Info -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :email, "Email Address *", class: "block font-bold text-stone-700 uppercase tracking-wider mb-1" %>
          <%= f.email_field :email, required: true, placeholder: "murray@pastoral.com.au", class: "w-full px-3.5 py-2.5 rounded-xl border border-stone-300 bg-stone-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-primary text-xs font-semibold" %>
          <span class="text-[10px] text-stone-400 mt-0.5 block">Your login &amp; approval notification email.</span>
        </div>
        <div>
          <%= f.label :phone, "Mobile / Phone Number *", class: "block font-bold text-stone-700 uppercase tracking-wider mb-1" %>
          <%= f.telephone_field :phone, required: true, placeholder: "e.g. 0418 901 234", class: "w-full px-3.5 py-2.5 rounded-xl border border-stone-300 bg-stone-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-primary text-xs font-semibold" %>
          <span class="text-[10px] text-stone-400 mt-0.5 block">Used for delivery driver updates &amp; gate coordination.</span>
        </div>
      </div>

      <!-- Farm / Business Details (Optional) -->
      <div class="pt-2 border-t border-stone-100">
        <h3 class="text-xs font-bold text-stone-900 uppercase tracking-wider mb-3">Farm, Property or Business Details</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <%= f.label :business_name, "Farm / Trading Name (Optional)", class: "block font-semibold text-stone-600 mb-1" %>
            <%= f.text_field :business_name, placeholder: "e.g. Chittering Valley Equestrian / Station", class: "w-full px-3.5 py-2.5 rounded-xl border border-stone-300 bg-stone-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-primary text-xs" %>
          </div>
          <div>
            <%= f.label :abn, "Australian Business Number (ABN, Optional)", class: "block font-semibold text-stone-600 mb-1" %>
            <%= f.text_field :abn, placeholder: "e.g. 12 345 678 901", class: "w-full px-3.5 py-2.5 rounded-xl border border-stone-300 bg-stone-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-primary text-xs font-mono" %>
          </div>
        </div>
      </div>

      <!-- Property Address -->
      <div class="space-y-3">
        <div>
          <%= f.label :property_address, "Property / Street Address", class: "block font-semibold text-stone-600 mb-1" %>
          <%= f.text_field :property_address, placeholder: "e.g. Lot 12 Great Northern Highway", class: "w-full px-3.5 py-2.5 rounded-xl border border-stone-300 bg-stone-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-primary text-xs" %>
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div class="col-span-1">
            <%= f.label :suburb, "Suburb / Town", class: "block font-semibold text-stone-600 mb-1" %>
            <%= f.text_field :suburb, placeholder: "e.g. Muchea", class: "w-full px-3.5 py-2.5 rounded-xl border border-stone-300 bg-stone-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-primary text-xs" %>
          </div>
          <div class="col-span-1">
            <%= f.label :postcode, "Postcode", class: "block font-semibold text-stone-600 mb-1" %>
            <%= f.text_field :postcode, placeholder: "6501", class: "w-full px-3.5 py-2.5 rounded-xl border border-stone-300 bg-stone-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-primary text-xs font-mono" %>
          </div>
          <div class="col-span-1">
            <%= f.label :state, "State", class: "block font-semibold text-stone-600 mb-1" %>
            <%= f.select :state, ["WA", "NSW", "VIC", "QLD", "SA", "TAS", "NT", "ACT"], { selected: "WA" }, class: "w-full px-3.5 py-2.5 rounded-xl border border-stone-300 bg-stone-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-primary text-xs font-bold" %>
          </div>
        </div>
      </div>

      <!-- Primary Agricultural Interest -->
      <div>
        <%= f.label :primary_interest, "Primary Feed / Supply Interest", class: "block font-bold text-stone-700 uppercase tracking-wider mb-1" %>
        <%= f.select :primary_interest, [
          "Equine Nutrition & Horse Feeds",
          "Beef Cattle & Pastoral Grower Pellets",
          "Sheep, Lambs & Mineral Licks",
          "Poultry Layer Feeds & Bird Seed",
          "Working Dog & Canine Nutrition",
          "Rural Hardware, Fencing Wire & Poly Pipe",
          "Mixed Farm / Hobby Block"
        ], { prompt: "Select your primary category..." }, class: "w-full px-3.5 py-2.5 rounded-xl border border-stone-300 bg-stone-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-primary text-xs" %>
      </div>

      <!-- Password -->
      <div class="pt-2 border-t border-stone-100">
        <h3 class="text-xs font-bold text-stone-900 uppercase tracking-wider mb-3">Choose Your Account Password</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <%= f.label :password, "Password (min 6 characters) *", class: "block font-semibold text-stone-600 mb-1" %>
            <%= f.password_field :password, required: true, placeholder: "••••••••", class: "w-full px-3.5 py-2.5 rounded-xl border border-stone-300 bg-stone-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-primary text-xs font-mono" %>
          </div>
          <div>
            <%= f.label :password_confirmation, "Confirm Password *", class: "block font-semibold text-stone-600 mb-1" %>
            <%= f.password_field :password_confirmation, required: true, placeholder: "••••••••", class: "w-full px-3.5 py-2.5 rounded-xl border border-stone-300 bg-stone-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-primary text-xs font-mono" %>
          </div>
        </div>
      </div>

      <!-- Approval Process Notice -->
      <div class="p-4 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 flex items-start gap-3">
        <svg class="w-5 h-5 text-amber-700 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        <div class="text-[11px] leading-relaxed">
          <strong class="font-bold block text-amber-950 mb-0.5">How Account Activation Works:</strong>
          When you click below, an activation notification is triggered directly to our Super Admin. Your profile will be in a <strong>pending</strong> status until authorized. Once approved, product prices and online checkout will unlock automatically.
        </div>
      </div>

      <!-- Submit Button -->
      <div>
        <%= f.submit "Complete Profile & Request Price Activation →", class: "w-full py-3.5 px-4 bg-brand-primary hover:bg-brand-primary-hover text-white text-xs font-extrabold uppercase tracking-wider rounded-xl shadow-md transition cursor-pointer" %>
      </div>
    <% end %>

    <div class="mt-6 pt-6 border-t border-stone-100 text-center text-xs text-stone-500">
      Already registered with us?
      <%= link_to "Sign In to Your Member Account →", customer_login_path, class: "font-bold text-brand-primary hover:underline ml-1" %>
    </div>
  </div>
</div>
