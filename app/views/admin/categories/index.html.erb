<% content_for :title, "Manage Feed & Supply Categories" %>

<div class="space-y-6">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-black text-bush-900 tracking-tight">Category & Department Management</h1>
      <p class="text-xs text-stone-500 mt-1">Organize products into animal feeds, nutrition, and hardware departments.</p>
    </div>

    <%= link_to new_admin_category_path, class: "px-4 py-2 bg-emerald-700 hover:bg-emerald-800 text-white rounded-xl text-xs font-black transition shadow flex items-center gap-1.5" do %>
      <span>➕ Add New Category</span>
    <% end %>
  </div>

  <div class="bg-white rounded-2xl border border-stone-200 shadow-sm overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-stone-100 text-stone-500 uppercase text-[10px] tracking-wider border-b border-stone-200">
          <tr>
            <th class="py-3 px-4">Category Name</th>
            <th class="py-3 px-4">Department (Phase 1 vs 2)</th>
            <th class="py-3 px-4">URL Slug</th>
            <th class="py-3 px-4 text-center">Active Products</th>
            <th class="py-3 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
          <% @categories.each do |cat| %>
            <tr class="hover:bg-stone-50 transition">
              <td class="py-3 px-4">
                <strong class="text-stone-900 block font-bold text-xs"><%= cat.name %></strong>
                <span class="text-stone-400 text-[10px]"><%= cat.description.to_s.truncate(60) %></span>
              </td>
              <td class="py-3 px-4">
                <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold <%= cat.live? ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800' %>">
                  <%= cat.department %> (<%= cat.live? ? 'Phase 1 Live' : 'Phase 2 Staging' %>)
                </span>
              </td>
              <td class="py-3 px-4 font-mono text-stone-600 text-[11px]"><%= cat.slug %></td>
              <td class="py-3 px-4 text-center">
                <span class="inline-block px-2 py-0.5 rounded-lg font-black text-xs bg-stone-100 text-stone-800">
                  <%= cat.products.count %>
                </span>
              </td>
              <td class="py-3 px-4 text-right">
                <div class="flex items-center justify-end gap-2">
                  <%= link_to "Edit", edit_admin_category_path(cat), class: "px-2.5 py-1 bg-stone-100 hover:bg-stone-200 text-stone-800 rounded font-bold text-xs transition" %>
                  <%= link_to "View Storefront ↗", category_path(cat), target: "_blank", class: "px-2.5 py-1 bg-bush-50 hover:bg-bush-100 text-bush-800 rounded font-bold text-xs transition" %>
                  <% if cat.products.empty? %>
                    <%= button_to "Delete", admin_category_path(cat), method: :delete, data: { turbo_confirm: "Are you sure you want to delete category '#{cat.name}'?" }, class: "px-2 py-1 bg-rose-50 hover:bg-rose-100 text-rose-700 rounded font-bold text-xs transition cursor-pointer" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
