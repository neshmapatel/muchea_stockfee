<% content_for :title, "Contact Us & Trading Hours | Muchea Stockfeed & Hardware" %>

<div class="bg-bush-900 text-white py-12 border-b-4 border-wheat-500">
  <div class="max-w-7xl mx-auto px-4">
    <span class="text-xs font-bold text-wheat-500 uppercase tracking-widest">Get In Touch</span>
    <h1 class="text-3xl sm:text-5xl font-black font-serif-brand mt-1">Contact Our Warehouse</h1>
    <p class="text-sm text-stone-300 mt-2 max-w-2xl">
      Have a question about hay availability, bulk feed deliveries, fencing materials, or truck routes? Call our friendly Muchea counter team or drop in with your ute.
    </p>
  </div>
</div>

<div class="max-w-7xl mx-auto px-4 py-12">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Contact Info -->
    <div class="lg:col-span-5 space-y-6">
      <div class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm space-y-4">
        <h2 class="text-lg font-bold text-bush-900 border-b border-stone-100 pb-3">Warehouse Details</h2>
        
        <div class="space-y-3 text-xs text-stone-600">
          <div class="flex items-start gap-3">
            <%= svg_icon("map-pin", css_class: "w-5 h-5 text-ochre-600 flex-shrink-0") %>
            <div>
              <strong class="text-stone-900 block text-sm">Store & Warehouse Address:</strong>
              <span>14 Great Northern Highway, Muchea WA 6501</span>
              <p class="text-[11px] text-stone-400 mt-0.5">Dual-lane entry suitable for prime movers, horse floats & cattle trucks.</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <%= svg_icon("phone", css_class: "w-5 h-5 text-ochre-600 flex-shrink-0") %>
            <div>
              <strong class="text-stone-900 block text-sm">Telephone:</strong>
              <a href="tel:0895718840" class="text-bush-800 font-bold hover:underline text-sm">(08) 9571 8840</a>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-ochre-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <div>
              <strong class="text-stone-900 block text-sm">Email:</strong>
              <a href="mailto:sales@mucheastockfeed.com.au" class="text-bush-800 hover:underline">sales@mucheastockfeed.com.au</a>
            </div>
          </div>
        </div>
      </div>

      <div class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm space-y-4">
        <h2 class="text-lg font-bold text-bush-900 border-b border-stone-100 pb-3">Trading Hours</h2>
        <div class="space-y-2 text-xs">
          <div class="flex justify-between py-1 border-b border-stone-100">
            <span class="text-stone-600 font-medium">Monday – Friday:</span>
            <strong class="text-stone-900">7:30 AM – 5:00 PM</strong>
          </div>
          <div class="flex justify-between py-1 border-b border-stone-100">
            <span class="text-stone-600 font-medium">Saturday:</span>
            <strong class="text-stone-900">8:00 AM – 4:00 PM</strong>
          </div>
          <div class="flex justify-between py-1">
            <span class="text-stone-600 font-medium">Sunday:</span>
            <strong class="text-stone-900">9:00 AM – 2:00 PM</strong>
          </div>
        </div>
      </div>
    </div>

    <!-- Enquiry Form -->
    <div class="lg:col-span-7">
      <div class="bg-white p-8 rounded-3xl border border-stone-200 shadow-sm space-y-6">
        <div>
          <h2 class="text-xl font-bold font-serif-brand text-bush-900">Send an Enquiry or Quote Request</h2>
          <p class="text-xs text-stone-500 mt-1">Need a quote for full semi-loads of hay, pallet rates of horse feed, or full boundary fencing wire?</p>
        </div>

        <form action="#" method="get" onsubmit="alert('Thank you for contacting Muchea Stockfeed & Hardware. A team member will respond shortly.'); return false;" class="space-y-4 text-xs">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block font-bold text-stone-700 mb-1">Your Name *</label>
              <input type="text" required placeholder="e.g. Murray Campbell" class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 focus:ring-2 focus:ring-bush-800 focus:outline-none">
            </div>
            <div>
              <label class="block font-bold text-stone-700 mb-1">Phone Number *</label>
              <input type="tel" required placeholder="e.g. 0418 901 234" class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 focus:ring-2 focus:ring-bush-800 focus:outline-none">
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block font-bold text-stone-700 mb-1">Email Address *</label>
              <input type="email" required placeholder="murray@station.com.au" class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 focus:ring-2 focus:ring-bush-800 focus:outline-none">
            </div>
            <div>
              <label class="block font-bold text-stone-700 mb-1">Property Location / Postcode</label>
              <input type="text" placeholder="e.g. Lower Chittering (6084)" class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 focus:ring-2 focus:ring-bush-800 focus:outline-none">
            </div>
          </div>

          <div>
            <label class="block font-bold text-stone-700 mb-1">Enquiry / Items Required</label>
            <textarea rows="4" placeholder="e.g. Looking for 3x 4x4 oaten hay rolls and 10x 20kg bags of Hygain Balanced delivered next Tuesday..." class="w-full px-3.5 py-2.5 rounded-xl border border-stone-300 focus:ring-2 focus:ring-bush-800 focus:outline-none"></textarea>
          </div>

          <button type="submit" class="px-6 py-3 bg-bush-800 hover:bg-bush-900 text-white font-bold rounded-xl transition text-xs uppercase tracking-wider">
            Submit Rural Enquiry
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

