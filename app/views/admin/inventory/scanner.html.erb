<% content_for :title, "Fast Barcode & SKU Restock Scanner" %>

<div class="max-w-4xl mx-auto space-y-6">
  <!-- Header with Quick Mode Explanation -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-bush-900 text-white p-6 rounded-3xl shadow-sm border border-bush-800">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-400 text-bush-950 text-xs font-black uppercase tracking-wider mb-2">
        <span>⚡ Wireless Barcode & Quick Restock Terminal</span>
      </div>
      <h1 class="text-2xl font-black tracking-tight text-white">Handheld Barcode Restock</h1>
      <p class="text-xs text-stone-300 mt-1 max-w-xl">
        Scan any product barcode with a USB/Bluetooth scanner gun or enter the SKU code. The system updates warehouse counts immediately and logs the inventory change.
      </p>
    </div>

    <div class="flex items-center gap-2">
      <%= link_to "← Full Inventory Table", admin_inventory_index_path, class: "px-4 py-2 bg-bush-800 hover:bg-bush-700 text-stone-200 text-xs font-bold rounded-xl transition border border-bush-700" %>
    </div>
  </div>

  <!-- Main Scanner Form Card -->
  <div class="bg-white rounded-3xl border border-stone-200 shadow-sm p-6 sm:p-8">
    <%= form_with url: scan_adjust_admin_inventory_index_path, method: :post, local: true, id: "scanner-form", class: "space-y-6" do |f| %>
      <!-- Mode Selection -->
      <div>
        <label class="block text-xs font-bold text-stone-700 uppercase tracking-wider mb-2">1. Select Action Mode</label>
        <div class="grid grid-cols-3 gap-3">
          <label class="relative flex flex-col items-center p-3 rounded-2xl border-2 cursor-pointer transition has-[:checked]:border-emerald-600 has-[:checked]:bg-emerald-50/70 border-stone-200 hover:border-stone-300">
            <input type="radio" name="mode" value="add" checked class="sr-only" onchange="updateModeHint('add')">
            <span class="text-lg mb-1">📦 ➕</span>
            <span class="text-xs font-black text-stone-900">Restock In (Add)</span>
            <span class="text-[10px] text-stone-500 text-center">New shipment delivery</span>
          </label>

          <label class="relative flex flex-col items-center p-3 rounded-2xl border-2 cursor-pointer transition has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50/70 border-stone-200 hover:border-stone-300">
            <input type="radio" name="mode" value="set" class="sr-only" onchange="updateModeHint('set')">
            <span class="text-lg mb-1">📋 🟰</span>
            <span class="text-xs font-black text-stone-900">Stocktake Count (Set)</span>
            <span class="text-[10px] text-stone-500 text-center">Physical count override</span>
          </label>

          <label class="relative flex flex-col items-center p-3 rounded-2xl border-2 cursor-pointer transition has-[:checked]:border-rose-600 has-[:checked]:bg-rose-50/70 border-stone-200 hover:border-stone-300">
            <input type="radio" name="mode" value="deduct" class="sr-only" onchange="updateModeHint('deduct')">
            <span class="text-lg mb-1">⚠️ ➖</span>
            <span class="text-xs font-black text-stone-900">Damage / Write-off</span>
            <span class="text-[10px] text-stone-500 text-center">Torn bag / farm breakage</span>
          </label>
        </div>
      </div>

      <!-- Quantity Selection -->
      <div>
        <div class="flex items-center justify-between mb-2">
          <label class="block text-xs font-bold text-stone-700 uppercase tracking-wider">2. Quantity to Apply</label>
          <span class="text-[11px] text-stone-400">Quick presets for rural pallet loads</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="flex items-center gap-1.5 flex-1">
            <button type="button" onclick="setQty(1)" class="qty-btn px-3 py-2 bg-stone-100 hover:bg-stone-200 rounded-xl text-xs font-bold text-stone-800 transition">1 Bag/Unit</button>
            <button type="button" onclick="setQty(5)" class="qty-btn px-3 py-2 bg-stone-100 hover:bg-stone-200 rounded-xl text-xs font-bold text-stone-800 transition">5 Bags</button>
            <button type="button" onclick="setQty(10)" class="qty-btn px-3 py-2 bg-stone-100 hover:bg-stone-200 rounded-xl text-xs font-bold text-stone-800 transition">10 Bags</button>
            <button type="button" onclick="setQty(20)" class="qty-btn px-3 py-2 bg-stone-100 hover:bg-stone-200 rounded-xl text-xs font-bold text-stone-800 transition">20 (Half Pallet)</button>
            <button type="button" onclick="setQty(40)" class="qty-btn px-3 py-2 bg-bush-800 hover:bg-bush-900 rounded-xl text-xs font-bold text-white transition">40 (Full Pallet)</button>
          </div>
          <div class="w-32">
            <%= f.number_field :quantity, value: 1, min: 1, id: "quantity_input", class: "w-full text-center font-black text-base px-3 py-2 rounded-xl border border-stone-300 focus:outline-none focus:ring-2 focus:ring-bush-800 bg-white" %>
          </div>
        </div>
      </div>

      <!-- Barcode / SKU Input Area -->
      <div class="bg-stone-50 p-6 rounded-2xl border-2 border-dashed border-stone-300 focus-within:border-bush-800 transition">
        <label for="barcode_input" class="block text-xs font-black text-bush-900 uppercase tracking-wider mb-2">
          3. Ready to Scan Barcode or Type SKU (Auto-submits on scan)
        </label>
        <div class="relative">
          <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none text-stone-400">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/></svg>
          </div>
          <%= f.text_field :barcode,
            id: "barcode_input",
            placeholder: "Point scanner gun here or type code (e.g. MIL-COOL-20KG or 9312345001)...",
            autofocus: true,
            autocomplete: "off",
            class: "w-full pl-14 pr-32 py-4 text-base font-mono font-bold text-stone-900 bg-white border border-stone-300 rounded-2xl focus:outline-none focus:ring-4 focus:ring-bush-800/20" %>

          <div class="absolute inset-y-0 right-2 flex items-center">
            <%= f.submit "Update Stock ⏎", class: "px-5 py-2.5 bg-bush-800 hover:bg-bush-900 text-white text-xs font-bold rounded-xl cursor-pointer shadow transition" %>
          </div>
        </div>
        <p class="text-[11px] text-stone-500 mt-2 flex items-center gap-1.5">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
          <span>Scanner Ready: Most USB and Bluetooth barcode scanners automatically send an [Enter] key after reading, instantly saving the stock count.</span>
        </p>
      </div>
    <% end %>
  </div>

  <!-- Last Scanned Product Card (if applicable) -->
  <% if @last_scanned.present? %>
    <div class="bg-emerald-50 border-2 border-emerald-400 p-6 rounded-3xl shadow-sm">
      <div class="flex items-start justify-between gap-4">
        <div class="flex items-center gap-4">
          <div class="w-14 h-14 rounded-2xl bg-white border border-emerald-200 flex items-center justify-center p-1 overflow-hidden">
            <img src="<%= @last_scanned.product.hero_image_url.presence || '/images/muchea_logo.jpg' %>" alt="" class="w-full h-full object-cover rounded-xl">
          </div>
          <div>
            <span class="inline-block text-[10px] font-black uppercase tracking-wider px-2 py-0.5 rounded bg-emerald-600 text-white mb-1">Last Updated Item</span>
            <h3 class="text-base font-black text-emerald-950"><%= @last_scanned.product.name %></h3>
            <p class="text-xs text-emerald-800 font-medium">
              Variant: <strong class="text-emerald-950"><%= @last_scanned.name %></strong> • SKU: <code class="font-mono bg-white px-1.5 py-0.5 rounded border border-emerald-300 text-emerald-900"><%= @last_scanned.sku %></code>
            </p>
          </div>
        </div>

        <div class="text-right">
          <span class="block text-[10px] font-bold uppercase text-emerald-700">Current Warehouse Stock</span>
          <span class="text-3xl font-black text-emerald-950"><%= @last_scanned.stock_quantity %></span>
          <span class="block text-[10px] text-emerald-800 font-semibold"><%= @last_scanned.formatted_price_with_gst %></span>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Recent Scan Logs in this Session -->
  <div class="bg-white rounded-3xl border border-stone-200 shadow-sm overflow-hidden">
    <div class="px-6 py-4 bg-stone-50 border-b border-stone-200 flex items-center justify-between">
      <h2 class="text-xs font-bold uppercase tracking-wider text-stone-600">Recent Barcode Scanner Activity Logs</h2>
      <span class="text-[10px] text-stone-400 font-mono">Live Session Audit</span>
    </div>

    <% if @recent_scans.any? %>
      <div class="divide-y divide-stone-100 text-xs">
        <% @recent_scans.each do |log| %>
          <div class="px-6 py-3.5 flex items-center justify-between hover:bg-stone-50">
            <div>
              <strong class="text-stone-900 block"><%= log.product_variant.product.name %> (<%= log.product_variant.name %>)</strong>
              <span class="text-[10px] text-stone-400 font-mono">
                SKU: <%= log.product_variant.sku %> • <%= log.created_at.strftime("%I:%M %p, %d %b") %> • <%= log.reason %>
                <% if log.admin_user %> • By <%= log.admin_user.name %><% end %>
              </span>
            </div>
            <div class="text-right">
              <span class="inline-block px-2.5 py-1 rounded-lg text-xs font-black <%= log.change_amount.positive? ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800' %>">
                <%= log.change_amount.positive? ? "+#{log.change_amount}" : log.change_amount %>
              </span>
              <span class="block text-[10px] text-stone-500 font-medium">New Stock: <%= log.new_quantity %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="p-8 text-center text-xs text-stone-400">
        No scans recorded in this session yet. Scan your first barcode above!
      </div>
    <% end %>
  </div>
</div>

<script>
  function setQty(val) {
    document.getElementById('quantity_input').value = val;
    document.getElementById('barcode_input').focus();
  }

  function updateModeHint(mode) {
    document.getElementById('barcode_input').focus();
  }

  // Auto focus input on load
  document.addEventListener('DOMContentLoaded', function() {
    var input = document.getElementById('barcode_input');
    if (input) {
      input.focus();
      input.select();
    }
  });
</script>

