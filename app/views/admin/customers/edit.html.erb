<% content_for :title, "Edit Member: #{@customer.name}" %>

<div class="max-w-3xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-black text-stone-900 tracking-tight">Edit Member Profile: <%= @customer.name %></h1>
      <p class="text-xs text-stone-500 mt-1">Update customer details, login credentials, or account verification status.</p>
    </div>
    <%= link_to "← Back to Profile", admin_customer_path(@customer), class: "px-3 py-2 bg-stone-200 hover:bg-stone-300 text-stone-800 text-xs font-bold rounded-xl transition" %>
  </div>

  <div class="bg-white rounded-2xl border border-stone-200 shadow-sm p-6 sm:p-8">
    <%= form_with model: [:admin, @customer], local: true, class: "space-y-6 text-xs" do |f| %>
      <% if @customer.errors.any? %>
        <div class="p-4 bg-rose-50 border border-rose-200 rounded-xl text-rose-800">
          <p class="font-bold mb-1">Please fix the following errors:</p>
          <ul class="list-disc list-inside space-y-0.5">
            <% @customer.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Name Fields -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :first_name, "First Name *", class: "block font-bold text-stone-700 mb-1" %>
          <%= f.text_field :first_name, class: "w-full px-3 py-2 rounded-xl border border-stone-300 focus:ring-2 focus:ring-brand-primary focus:outline-none", required: true %>
        </div>
        <div>
          <%= f.label :last_name, "Last Name *", class: "block font-bold text-stone-700 mb-1" %>
          <%= f.text_field :last_name, class: "w-full px-3 py-2 rounded-xl border border-stone-300 focus:ring-2 focus:ring-brand-primary focus:outline-none", required: true %>
        </div>
      </div>

      <!-- Contact Fields -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :email, "Email Address * (Used for member login)", class: "block font-bold text-stone-700 mb-1" %>
          <%= f.email_field :email, class: "w-full px-3 py-2 rounded-xl border border-stone-300 focus:ring-2 focus:ring-brand-primary focus:outline-none", required: true %>
        </div>
        <div>
          <%= f.label :phone, "Mobile / Phone Number *", class: "block font-bold text-stone-700 mb-1" %>
          <%= f.telephone_field :phone, class: "w-full px-3 py-2 rounded-xl border border-stone-300 focus:ring-2 focus:ring-brand-primary focus:outline-none", required: true %>
        </div>
      </div>

      <!-- Business / Farm Details -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :business_name, "Farm / Business Name", class: "block font-bold text-stone-700 mb-1" %>
          <%= f.text_field :business_name, placeholder: "e.g. Muchea Pastoral Co", class: "w-full px-3 py-2 rounded-xl border border-stone-300 focus:ring-2 focus:ring-brand-primary focus:outline-none" %>
        </div>
        <div>
          <%= f.label :abn, "Australian Business Number (ABN)", class: "block font-bold text-stone-700 mb-1" %>
          <%= f.text_field :abn, placeholder: "e.g. 56 700 841 550", class: "w-full px-3 py-2 rounded-xl border border-stone-300 focus:ring-2 focus:ring-brand-primary focus:outline-none" %>
        </div>
      </div>

      <!-- Address Details -->
      <div class="space-y-4 pt-2 border-t border-stone-100">
        <div>
          <%= f.label :property_address, "Property / Delivery Address", class: "block font-bold text-stone-700 mb-1" %>
          <%= f.text_field :property_address, placeholder: "e.g. 17b Edwards Pl", class: "w-full px-3 py-2 rounded-xl border border-stone-300 focus:ring-2 focus:ring-brand-primary focus:outline-none" %>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <%= f.label :suburb, "Suburb / Town", class: "block font-bold text-stone-700 mb-1" %>
            <%= f.text_field :suburb, placeholder: "Muchea", class: "w-full px-3 py-2 rounded-xl border border-stone-300 focus:ring-2 focus:ring-brand-primary focus:outline-none" %>
          </div>
          <div>
            <%= f.label :postcode, "Postcode", class: "block font-bold text-stone-700 mb-1" %>
            <%= f.text_field :postcode, placeholder: "6501", class: "w-full px-3 py-2 rounded-xl border border-stone-300 focus:ring-2 focus:ring-brand-primary focus:outline-none" %>
          </div>
          <div>
            <%= f.label :state, "State", class: "block font-bold text-stone-700 mb-1" %>
            <%= f.select :state, ["WA", "NSW", "VIC", "QLD", "SA", "TAS", "NT", "ACT"], {}, class: "w-full px-3 py-2 rounded-xl border border-stone-300 focus:ring-2 focus:ring-brand-primary focus:outline-none bg-stone-50" %>
          </div>
        </div>
      </div>

      <!-- Membership & Interests -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 border-t border-stone-100">
        <div>
          <%= f.label :primary_interest, "Primary Feed / Supply Interest", class: "block font-bold text-stone-700 mb-1" %>
          <%= f.select :primary_interest, [
            "Equine Feed & Nutrition",
            "Hay, Chaff & Bedding",
            "Cattle, Sheep & Livestock",
            "Poultry & Bird Seed",
            "Working Dog & Pet Food",
            "Hardware & Rural Supplies"
          ], { include_blank: "Select interest..." }, class: "w-full px-3 py-2 rounded-xl border border-stone-300 focus:ring-2 focus:ring-brand-primary focus:outline-none bg-stone-50" %>
        </div>
        <div>
          <%= f.label :status, "Membership Status", class: "block font-bold text-stone-700 mb-1" %>
          <%= f.select :status, [
            ["Approved (Can view prices & buy)", "approved"],
            ["Pending (Awaiting approval)", "pending"],
            ["Declined / Suspended", "rejected"]
          ], {}, class: "w-full px-3 py-2 rounded-xl border border-stone-300 focus:ring-2 focus:ring-brand-primary focus:outline-none bg-stone-50 font-bold" %>
        </div>
      </div>

      <!-- Password Reset (Optional) -->
      <div class="pt-2 border-t border-stone-100">
        <%= f.label :password, "Set New Password (Leave blank to keep existing password)", class: "block font-bold text-stone-700 mb-1" %>
        <%= f.password_field :password, placeholder: "••••••••", class: "w-full sm:w-1/2 px-3 py-2 rounded-xl border border-stone-300 focus:ring-2 focus:ring-brand-primary focus:outline-none" %>
        <p class="text-[11px] text-stone-400 mt-1">If entered, minimum 6 characters. The member can use this new password immediately.</p>
      </div>

      <!-- Action Buttons -->
      <div class="flex items-center gap-3 pt-4 border-t border-stone-100">
        <%= f.submit "Save Changes", class: "px-6 py-2.5 bg-brand-primary hover:bg-brand-primary-hover text-white font-bold rounded-xl transition shadow cursor-pointer text-xs" %>
        <%= link_to "Cancel", admin_customer_path(@customer), class: "px-4 py-2.5 bg-stone-100 hover:bg-stone-200 text-stone-700 font-bold rounded-xl transition text-xs" %>
      </div>
    <% end %>
  </div>
</div>
