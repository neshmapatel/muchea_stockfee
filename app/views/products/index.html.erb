<% content_for :title, params[:q].present? ? "Search: #{params[:q]} | Product Catalog" : "All Feeds, Supplies & Rural Hardware" %>

<div class="bg-bush-900 text-white py-10 border-b-4 border-wheat-500">
  <div class="max-w-7xl mx-auto px-4">
    <span class="text-xs font-bold text-wheat-500 uppercase tracking-widest">Complete Muchea Warehouse Catalog</span>
    <h1 class="text-2xl sm:text-4xl font-black font-serif-brand mt-1">
      <% if params[:q].present? %>
        Search Results for "<span class="text-wheat-500"><%= params[:q] %></span>"
      <% elsif params[:department].present? %>
        <%= params[:department] %>
      <% else %>
        All Animal Feeds, Grains & Rural Hardware
      <% end %>
    </h1>
    <p class="text-xs sm:text-sm text-stone-300 mt-1 max-w-2xl">
      Browse our extensive inventory of equine feeds, prime hay rolls, livestock lick blocks, working dog kibble, cyclone fencing, and rural poly fittings.
    </p>
  </div>
</div>

<div class="max-w-7xl mx-auto px-4 py-10">
  <!-- Top Department Filter Pills -->
  <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-6 text-xs whitespace-nowrap">
    <%= link_to "All Departments", products_path, class: "px-3.5 py-1.5 rounded-full font-bold transition #{params[:department].blank? ? 'bg-bush-800 text-white' : 'bg-white text-stone-700 border border-stone-200 hover:bg-stone-50'}" %>
    <%= link_to "Stockfeed & Animal Nutrition", products_path(department: "Stockfeed & Animal Nutrition"), class: "px-3.5 py-1.5 rounded-full font-bold transition #{params[:department] == 'Stockfeed & Animal Nutrition' ? 'bg-bush-800 text-white' : 'bg-white text-stone-700 border border-stone-200 hover:bg-stone-50'}" %>
    <%= link_to "Rural Hardware & Farm Supplies", products_path(department: "Rural Hardware & Farm Supplies"), class: "px-3.5 py-1.5 rounded-full font-bold transition #{params[:department] == 'Rural Hardware & Farm Supplies' ? 'bg-bush-800 text-white' : 'bg-white text-stone-700 border border-stone-200 hover:bg-stone-50'}" %>
  </div>

  <div class="flex items-center justify-between mb-6 pb-2 border-b border-stone-200 text-xs text-stone-500">
    <span>Displaying <%= @products.count %> products</span>
    <% if params[:q].present? || params[:department].present? %>
      <%= link_to "View All Products", products_path, class: "text-bush-800 hover:underline font-semibold" %>
    <% end %>
  </div>

  <% if @products.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <% @products.each do |product| %>
        <div class="bg-white rounded-2xl border border-stone-200 overflow-hidden shadow-sm hover:shadow-md transition flex flex-col justify-between group">
          <div>
            <div class="relative h-48 bg-stone-200 overflow-hidden">
              <img src="<%= product.hero_image_url.presence || '/images/muchea_logo.jpg' %>" alt="<%= product.name %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
              <div class="absolute top-2.5 left-2.5">
                <span class="bg-bush-900 text-white text-[10px] font-bold uppercase px-2 py-0.5 rounded shadow">
                  <%= product.brand %>
                </span>
              </div>
            </div>

            <div class="p-4">
              <span class="text-[10px] font-bold text-stone-400 uppercase tracking-wider"><%= product.category.name %></span>
              <h3 class="text-sm font-bold text-stone-900 hover:text-bush-800 line-clamp-2 mt-1">
                <%= link_to product.name, product_path(product) %>
              </h3>
              <p class="text-xs text-stone-500 mt-1 line-clamp-2"><%= product.short_description %></p>
            </div>
          </div>

          <div class="p-4 pt-0 border-t border-stone-100 mt-2">
            <div class="flex items-baseline justify-between mb-3 pt-2">
              <div>
                <span class="block text-base font-black text-bush-900"><%= product.price_display %></span>
                <span class="block text-[10px] text-stone-400">AUD inc. 10% GST</span>
              </div>
              <span class="text-[11px] font-bold <%= product.in_stock? ? 'text-emerald-700' : 'text-rose-600' %>">
                <%= product.in_stock? ? "In Stock" : "Backorder" %>
              </span>
            </div>

            <div class="flex items-center gap-2">
              <%= link_to "Select Size & Buy", product_path(product), class: "flex-1 py-2 text-center text-xs font-bold bg-bush-800 hover:bg-bush-900 text-white rounded-lg transition" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white p-12 text-center rounded-2xl border border-stone-200">
      <p class="text-stone-600 text-sm font-semibold">No products found matching your search.</p>
      <p class="text-xs text-stone-400 mt-1">Try searching for "horse feed", "barley", "hay", "fencing", or "pickets".</p>
      <%= link_to "Browse Complete Catalog", products_path, class: "mt-4 inline-block px-5 py-2.5 bg-bush-800 text-white rounded-lg text-xs font-bold" %>
    </div>
  <% end %>
</div>

