<!-- Storefront Signboard Hero (Clean, Authentic Retail Layout) -->
<section class="bg-brand-dark border-b border-stone-800">
  <div class="max-w-7xl mx-auto px-4 pt-5 pb-6">
    <!-- Real Storefront Signboard Banner -->
    <div class="overflow-hidden rounded-lg border border-stone-800 bg-black shadow-md">
      <img src="/images/muchea_signboard.jpg"
           alt="Muchea Stock Feed & Hardware — For Farms, Homes & Lifestyles — Quality Products for a Stronger Tomorrow"
           class="w-full h-auto block object-contain"
           style="width: 100%; height: auto; display: block;">
    </div>

    <!-- Clean Hero Intro & Direct Actions -->
    <div class="mt-6 flex flex-col lg:flex-row lg:items-center justify-between gap-6 text-white">
      <div class="max-w-3xl space-y-2.5">
        <p class="text-[11px] font-bold uppercase tracking-widest text-brand-accent">
          14 Great Northern Highway, Muchea WA • Quality Products for a Stronger Tomorrow
        </p>
        <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-white leading-tight">
          Trusted Animal Feeds, Hay &amp; Chaff — Direct from Our Muchea Shed
        </h1>
        <p class="text-sm text-stone-300 leading-relaxed">
          Order horse feeds, prime oaten hay, lucerne chaff, cattle grain, poultry layer pellets, and working dog food online.
          Book a scheduled WA farm truck delivery or pull into Drive-Thru Bays 1 &amp; 2 for assisted loading.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row lg:flex-col gap-2.5 flex-shrink-0">
        <%= link_to products_path(department: "Stockfeed & Animal Nutrition"), class: "px-6 py-3 bg-brand-primary hover:bg-brand-primary-hover text-white font-bold rounded-lg text-sm text-center transition" do %>
          Shop All Live Stockfeed →
        <% end %>
        <div class="flex items-center gap-2">
          <%= link_to "Delivery Timetable", delivery_schedule_path, class: "flex-1 px-4 py-2.5 bg-stone-800 hover:bg-stone-700 text-stone-100 font-semibold rounded-lg border border-stone-700 text-xs text-center transition whitespace-nowrap" %>
          <%= link_to "Drive-Thru Bay", drive_thru_pickup_path, class: "flex-1 px-4 py-2.5 bg-stone-800 hover:bg-stone-700 text-stone-100 font-semibold rounded-lg border border-stone-700 text-xs text-center transition whitespace-nowrap" %>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 5 Core Storefront Pillars (Matching the 5 Red Circles on the Signboard) -->
<section class="bg-white border-b border-stone-200 py-5">
  <div class="max-w-7xl mx-auto px-4 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
    <div class="flex items-center gap-3 p-2">
      <div class="w-10 h-10 rounded-full bg-brand-primary text-white flex items-center justify-center flex-shrink-0 border-2 border-brand-primary/20">
        <%= svg_icon("wheat", css_class: "w-5 h-5 text-white") %>
      </div>
      <div>
        <span class="block text-xs font-extrabold uppercase tracking-wide text-stone-900">Stockfeed</span>
        <span class="block text-[11px] text-stone-500">Live Online Now</span>
      </div>
    </div>

    <div class="flex items-center gap-3 p-2">
      <div class="w-10 h-10 rounded-full bg-brand-primary text-white flex items-center justify-center flex-shrink-0 border-2 border-brand-primary/20">
        <%= svg_icon("paw", css_class: "w-5 h-5 text-white") %>
      </div>
      <div>
        <span class="block text-xs font-extrabold uppercase tracking-wide text-stone-900">Pet Care</span>
        <span class="block text-[11px] text-stone-500">Dog &amp; Bird Feeds</span>
      </div>
    </div>

    <div class="flex items-center gap-3 p-2">
      <div class="w-10 h-10 rounded-full bg-brand-primary text-white flex items-center justify-center flex-shrink-0 border-2 border-brand-primary/20">
        <%= svg_icon("truck", css_class: "w-5 h-5 text-white") %>
      </div>
      <div>
        <span class="block text-xs font-extrabold uppercase tracking-wide text-stone-900">Farm Supplies</span>
        <span class="block text-[11px] text-stone-500">Hay, Chaff &amp; Licks</span>
      </div>
    </div>

    <div class="flex items-center gap-3 p-2 opacity-85">
      <div class="w-10 h-10 rounded-full bg-stone-800 text-white flex items-center justify-center flex-shrink-0 border-2 border-stone-300">
        <%= svg_icon("fence", css_class: "w-5 h-5 text-white") %>
      </div>
      <div>
        <span class="block text-xs font-extrabold uppercase tracking-wide text-stone-900">Hardware</span>
        <span class="block text-[11px] text-brand-accent font-semibold">Coming Phase 2</span>
      </div>
    </div>

    <div class="flex items-center gap-3 p-2 opacity-85 col-span-2 sm:col-span-1">
      <div class="w-10 h-10 rounded-full bg-stone-800 text-white flex items-center justify-center flex-shrink-0 border-2 border-stone-300">
        <%= svg_icon("pipe", css_class: "w-5 h-5 text-white") %>
      </div>
      <div>
        <span class="block text-xs font-extrabold uppercase tracking-wide text-stone-900">Rural Essentials</span>
        <span class="block text-[11px] text-brand-accent font-semibold">Coming Phase 2</span>
      </div>
    </div>
  </div>
</section>

<!-- Shop By Department Grid -->
<section class="max-w-7xl mx-auto px-4 py-10">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-6 pb-3 border-b border-stone-200 gap-2">
    <div>
      <h2 class="text-xl sm:text-2xl font-extrabold text-stone-900">Shop Feeds by Animal &amp; Department</h2>
      <p class="text-xs text-stone-500 mt-0.5">All feeds listed below are stocked at Muchea and available for delivery or pickup.</p>
    </div>
    <div class="text-xs text-stone-600">
      Counter Advice: <a href="tel:0895718840" class="font-bold text-brand-primary hover:underline">(08) 9571 8840</a>
    </div>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
    <% @live_categories.each do |cat| %>
      <%= link_to category_path(cat), class: "group bg-white p-4 rounded-lg border border-stone-200 hover:border-brand-primary transition flex flex-col justify-between" do %>
        <div>
          <div class="w-11 h-11 rounded-lg bg-stone-100 group-hover:bg-brand-primary text-stone-800 group-hover:text-white flex items-center justify-center mb-3 transition">
            <%= svg_icon(cat.icon, css_class: "w-6 h-6") %>
          </div>
          <h3 class="text-sm font-bold text-stone-900 group-hover:text-brand-primary transition leading-snug">
            <%= cat.name %>
          </h3>
          <p class="text-[11px] text-stone-500 mt-1 line-clamp-2 leading-relaxed">
            <%= cat.description %>
          </p>
        </div>
        <div class="mt-4 pt-2.5 border-t border-stone-100 flex items-center justify-between text-xs font-bold text-stone-700 group-hover:text-brand-primary">
          <span><%= cat.products.size %> items</span>
          <span>→</span>
        </div>
      <% end %>
    <% end %>
  </div>
</section>

<!-- Popular Live Stockfeeds Catalog -->
<section class="bg-white py-10 border-y border-stone-200">
  <div class="max-w-7xl mx-auto px-4">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-6 pb-3 border-b border-stone-100 gap-2">
      <div>
        <h2 class="text-xl sm:text-2xl font-extrabold text-stone-900">Popular Stockfeeds, Hay &amp; Chaff</h2>
        <p class="text-xs text-stone-500 mt-0.5">Individual bags, 40-bag pallets, 4x4 round bales, and 1-tonne bulka bags.</p>
      </div>
      <%= link_to "View All Live Stockfeed (#{Product.live.count}) →", products_path(department: "Stockfeed & Animal Nutrition"), class: "text-xs font-bold text-brand-primary hover:underline" %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      <% @featured_feed_products.each do |product| %>
        <div class="bg-stone-50/40 rounded-lg border border-stone-200 overflow-hidden hover:border-stone-400 transition flex flex-col justify-between group">
          <div>
            <div class="relative h-48 bg-stone-100 overflow-hidden border-b border-stone-200">
              <img src="<%= product.hero_image_url.presence || '/images/muchea_logo.jpg' %>" alt="<%= product.name %>" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
              <div class="absolute top-2 left-2">
                <span class="bg-stone-950/90 text-white text-[10px] font-bold uppercase px-2 py-0.5 rounded">
                  <%= product.brand %>
                </span>
              </div>
            </div>

            <div class="p-4">
              <span class="text-[10px] font-bold text-stone-400 uppercase tracking-wider"><%= product.category.name %></span>
              <h3 class="text-sm font-bold text-stone-900 mt-1 line-clamp-2 hover:text-brand-primary">
                <%= link_to product.name, product_path(product) %>
              </h3>
              <p class="text-xs text-stone-500 mt-1 line-clamp-2"><%= product.short_description %></p>
            </div>
          </div>

          <div class="p-4 pt-0 mt-1">
            <div class="flex items-baseline justify-between mb-3 pt-2.5 border-t border-stone-200/70">
              <div>
                <span class="block text-base font-black text-stone-950">
                  <%= product.price_display %>
                </span>
                <span class="block text-[10px] text-stone-500">AUD inc. 10% GST</span>
              </div>
              <span class="text-[11px] font-bold <%= product.in_stock? ? 'text-emerald-700' : 'text-rose-600' %>">
                <%= product.in_stock? ? "In Stock (#{product.total_stock})" : "Out of Stock" %>
              </span>
            </div>

            <%= link_to "Select Size & Order", product_path(product), class: "block w-full py-2.5 text-center text-xs font-bold bg-brand-dark hover:bg-brand-primary text-white rounded-lg transition" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<!-- Rural Hardware Yard Expansion (Phase 2 Coming Soon) -->
<section class="max-w-7xl mx-auto px-4 py-10">
  <div class="bg-brand-dark text-white rounded-xl p-6 sm:p-8 border border-stone-800">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 pb-4 border-b border-stone-800">
      <div class="max-w-2xl">
        <span class="inline-block bg-brand-primary text-white text-[10px] font-bold uppercase px-2.5 py-0.5 rounded mb-2 tracking-wider">
          Coming in Phase 2
        </span>
        <h2 class="text-xl sm:text-2xl font-extrabold leading-tight">
          Rural Hardware, Boundary Fencing Wire &amp; Poly Pipe
        </h2>
        <p class="text-xs sm:text-sm text-stone-300 mt-1.5 leading-relaxed">
          We are expanding our Muchea yard to carry Waratah cyclone fencing wire, star pickets, Philmac poly fittings, and livestock water troughs. Call <strong class="text-white">(08) 9571 8840</strong> for contractor bulk slings and advance quotes.
        </p>
      </div>
      <%= link_to "Request Trade Quote →", contact_path, class: "px-5 py-2.5 bg-white hover:bg-stone-100 text-stone-950 font-bold text-xs rounded-lg transition whitespace-nowrap self-start md:self-center" %>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <% @coming_soon_hardware_products.each do |hw| %>
        <div class="bg-stone-950 border border-stone-800 rounded-lg p-3.5 flex flex-col justify-between">
          <div>
            <div class="h-28 rounded overflow-hidden mb-3 bg-stone-800">
              <img src="<%= hw.hero_image_url.presence || '/images/muchea_logo.jpg' %>" alt="<%= hw.name %>" class="w-full h-full object-cover opacity-85">
            </div>
            <span class="text-[10px] font-bold uppercase tracking-wider text-stone-400 block"><%= hw.brand %></span>
            <h4 class="text-xs font-bold text-white mt-0.5 line-clamp-1"><%= hw.name %></h4>
            <span class="text-xs font-bold text-stone-200 mt-1 block"><%= hw.price_display %></span>
          </div>
          <div class="mt-3 pt-2 border-t border-stone-800 flex items-center justify-between text-[11px]">
            <span class="text-brand-accent font-semibold">Arriving Soon</span>
            <%= link_to "View Specs →", product_path(hw), class: "text-stone-300 hover:text-white font-semibold" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<!-- Weekly Delivery Schedule & Drive-Thru Bag Loading -->
<section class="max-w-7xl mx-auto px-4 pb-12 space-y-6">
  <div class="bg-white rounded-xl border border-stone-200 p-6 sm:p-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-6 pb-3 border-b border-stone-100 gap-2">
      <div>
        <h2 class="text-xl font-extrabold text-stone-900">Scheduled WA Farm Truck Deliveries</h2>
        <p class="text-xs text-stone-500 mt-0.5">Order by 3:00 PM on the working day prior to your local truck run. Gate codes and paddock drop notes supported at checkout.</p>
      </div>
      <%= link_to "Full Delivery Rates →", delivery_schedule_path, class: "text-xs font-bold text-brand-primary hover:underline whitespace-nowrap" %>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% @delivery_zones.each do |zone| %>
        <div class="p-4 rounded-lg bg-stone-50 border border-stone-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide bg-stone-900 text-white mb-1.5">
              <%= zone.scheduled_days %>
            </span>
            <h4 class="text-sm font-bold text-stone-900"><%= zone.name %></h4>
            <p class="text-xs text-stone-500 mt-0.5"><%= zone.description %></p>
            <p class="text-[11px] text-stone-500 mt-1">Postcodes: <strong class="text-stone-800"><%= zone.postcodes %></strong></p>
          </div>
          <div class="text-left sm:text-right flex-shrink-0">
            <span class="text-base font-black text-stone-950 block"><%= zone.formatted_fee %></span>
            <% if zone.free_threshold_cents.present? %>
              <span class="text-[10px] text-emerald-700 font-bold block">Free over <%= format_aud(zone.free_threshold_cents) %></span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Drive-Thru Loading Strip -->
  <div class="bg-stone-100 border border-stone-200 rounded-xl p-6 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4">
    <div class="flex items-start sm:items-center gap-4">
      <div class="px-3.5 py-2.5 rounded-lg bg-brand-primary text-white font-black text-sm flex-shrink-0">
        Bay 1 &amp; 2
      </div>
      <div>
        <h3 class="text-base sm:text-lg font-extrabold text-stone-900">Drive-Thru Bag Loading</h3>
        <p class="text-xs sm:text-sm text-stone-600 mt-0.5 max-w-2xl">
          Order online for Warehouse Pickup and drive straight into Bays 1 or 2 at 14 Great Northern Hwy, Muchea. Our team loads your 20kg bags, hay rolls, and pallets onto your ute or trailer.
        </p>
      </div>
    </div>
    <%= link_to "Drive-Thru Instructions →", drive_thru_pickup_path, class: "px-5 py-2.5 bg-brand-dark hover:bg-brand-primary text-white font-bold text-xs rounded-lg whitespace-nowrap transition" %>
  </div>
</section>
