<% content_for :title, "Track Your Rural Order | Muchea Stockfeed & Hardware" %>

<div class="bg-bush-900 text-white py-12 border-b-4 border-wheat-500">
  <div class="max-w-7xl mx-auto px-4 text-center">
    <span class="text-xs font-bold text-wheat-500 uppercase tracking-widest">Western Australia Logistics</span>
    <h1 class="text-3xl sm:text-5xl font-black font-serif-brand mt-1">Live Order & Shipment Tracking</h1>
    <p class="text-xs sm:text-sm text-stone-300 mt-2 max-w-xl mx-auto">
      Track the status of your stockfeed bags, hay rolls, or fencing hardware as our warehouse team picks, packs, and delivers your order.
    </p>
  </div>
</div>

<div class="max-w-xl mx-auto px-4 py-12">
  <div class="bg-white p-8 rounded-3xl border border-stone-200 shadow-sm space-y-6">
    <h2 class="text-lg font-bold text-bush-900 text-center">Enter Order Details</h2>

    <%= form_with url: tracking_lookup_path, method: :get, local: true, class: "space-y-4 text-xs" do |f| %>
      <div>
        <label class="block font-bold text-stone-700 mb-1">Tracking Code or Order Number *</label>
        <%= f.text_field :query, value: params[:query], placeholder: "e.g. WA7821AU or MSH-2026-123456", required: true, class: "w-full px-4 py-3 rounded-xl border border-stone-300 font-mono text-sm bg-stone-50 focus:outline-none focus:ring-2 focus:ring-bush-800" %>
        <p class="text-[11px] text-stone-400 mt-1">Found on your order confirmation SMS, email, or printable tax invoice.</p>
      </div>

      <%= f.submit "Track Consignment Status →", class: "w-full py-3.5 bg-bush-800 hover:bg-bush-900 text-white font-bold rounded-xl transition cursor-pointer uppercase tracking-wider text-xs shadow-md" %>
    <% end %>

    <div class="p-4 bg-stone-50 rounded-xl border border-stone-100 text-[11px] text-stone-500 space-y-1">
      <strong class="text-stone-700 block">Try a Demo Consignment:</strong>
      <div class="flex gap-2 pt-1 font-mono">
        <%= link_to "WA7821AU (Dispatched Farm Delivery)", tracking_path("WA7821AU"), class: "text-bush-800 underline font-bold" %>
        <span>•</span>
        <%= link_to "WA9934AU (Drive-Thru Pickup)", tracking_path("WA9934AU"), class: "text-bush-800 underline font-bold" %>
      </div>
    </div>
  </div>
</div>

