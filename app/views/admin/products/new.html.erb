<% content_for :title, "Add New Stockfeed Product" %>

<div class="max-w-4xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-black text-bush-900 tracking-tight">Add New Product to Warehouse</h1>
      <p class="text-xs text-stone-500 mt-1">Enter feed specifications, pricing, barcode, and initial stock count.</p>
    </div>

    <%= link_to "← Back to Products", admin_products_path, class: "px-4 py-2 bg-stone-200 hover:bg-stone-300 text-stone-800 text-xs font-bold rounded-xl transition" %>
  </div>

  <%= render "form", product: @product %>
</div>
