<!DOCTYPE html>
<html lang="en-AU">
<head>
  <meta charset="utf-8">
  <title>Tax Invoice - <%= @order.order_number %> | Muchea Stockfeed & Hardware</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @media print {
      .no-print { display: none !important; }
      body { background: white !important; }
    }
  </style>
</head>
<body class="bg-stone-100 text-stone-900 text-xs py-8 px-4 font-sans">
  <div class="max-w-3xl mx-auto mb-4 text-right no-print">
    <button onclick="window.print()" class="px-4 py-2 bg-stone-800 text-white font-bold rounded-lg hover:bg-stone-900 transition">
      🖨️ Print Tax Invoice
    </button>
  </div>

  <div class="max-w-3xl mx-auto bg-white p-10 rounded-2xl border border-stone-300 shadow-sm space-y-8">
    <!-- Header -->
    <div class="flex justify-between items-start border-b border-stone-200 pb-6">
      <div class="flex items-center gap-4">
        <img src="/images/muchea_logo.jpg" alt="Logo" class="w-16 h-16 rounded-full border border-stone-300">
        <div>
          <h1 class="text-xl font-black uppercase tracking-wider text-stone-900">Muchea Stockfeed & Hardware</h1>
          <p class="text-stone-500 font-semibold">Muchea Stockfeed & Hardware Pty Ltd</p>
          <p class="text-stone-600 font-bold mt-1">ABN: 48 619 284 921</p>
          <p class="text-stone-500">14 Great Northern Highway, Muchea WA 6501</p>
          <p class="text-stone-500">Phone: (08) 9571 8840 • sales@mucheastockfeed.com.au</p>
        </div>
      </div>

      <div class="text-right">
        <span class="inline-block bg-stone-900 text-white font-black text-sm px-3 py-1 rounded uppercase tracking-widest">
          TAX INVOICE
        </span>
        <p class="text-stone-400 text-[10px] mt-2 font-mono">Invoice #: <strong class="text-stone-800"><%= @order.order_number %></strong></p>
        <p class="text-stone-400 text-[10px]">Date: <strong class="text-stone-800"><%= @order.created_at.strftime("%d %B %Y") %></strong></p>
        <p class="text-stone-400 text-[10px]">Status: <strong class="text-emerald-700 uppercase font-black">PAID</strong></p>
      </div>
    </div>

    <!-- Billed / Delivered To -->
    <div class="grid grid-cols-2 gap-6 bg-stone-50 p-4 rounded-xl border border-stone-200">
      <div>
        <span class="block text-stone-400 font-bold uppercase text-[10px]">Customer / Account</span>
        <strong class="text-stone-900 text-sm block mt-0.5"><%= @order.customer_name %></strong>
        <p class="text-stone-600"><%= @order.customer_email %></p>
        <p class="text-stone-600"><%= @order.customer_phone %></p>
      </div>

      <div>
        <span class="block text-stone-400 font-bold uppercase text-[10px]">Fulfillment Destination</span>
        <% if @order.pickup? %>
          <strong class="text-stone-900 text-sm block mt-0.5">Warehouse Drive-Thru Bag Loading</strong>
          <p class="text-stone-600">Bay 1 or 2, 14 Great Northern Hwy, Muchea WA 6501</p>
        <% else %>
          <strong class="text-stone-900 text-sm block mt-0.5">Rural Paddock / Farm Delivery</strong>
          <p class="text-stone-600"><%= @order.delivery_address %></p>
          <p class="text-stone-600"><%= @order.suburb %> WA <%= @order.postcode %></p>
        <% end %>
      </div>
    </div>

    <!-- Line Items Table -->
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="border-b-2 border-stone-300 text-stone-500 uppercase text-[10px] tracking-wider">
          <th class="py-2.5">Item Description</th>
          <th class="py-2.5 text-center">SKU</th>
          <th class="py-2.5 text-center">Qty</th>
          <th class="py-2.5 text-right">Unit Price (inc. GST)</th>
          <th class="py-2.5 text-right">Total (AUD)</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-stone-200">
        <% @order.items.each do |item| %>
          <tr>
            <td class="py-3">
              <strong class="text-stone-900 block"><%= item.product_variant.product.name %></strong>
              <span class="text-stone-500 text-[11px]"><%= item.product_variant.name %></span>
            </td>
            <td class="py-3 text-center font-mono text-stone-600"><%= item.product_variant.sku %></td>
            <td class="py-3 text-center font-bold text-stone-900"><%= item.quantity %></td>
            <td class="py-3 text-right text-stone-700">AU$ <%= format('%.2f', item.unit_price_cents / 100.0) %></td>
            <td class="py-3 text-right font-bold text-stone-900"><%= item.formatted_total %></td>
          </tr>
        <% end %>
      </tbody>
    </table>

    <!-- Totals Breakdown complying with ATO Tax Invoice Regulations -->
    <div class="flex justify-end pt-4 border-t border-stone-200">
      <div class="w-72 space-y-2 text-xs">
        <div class="flex justify-between text-stone-600">
          <span>Subtotal (inc. GST):</span>
          <span class="font-bold text-stone-900"><%= format_aud(@order.subtotal_cents) %></span>
        </div>
        <div class="flex justify-between text-stone-600">
          <span>Freight / Local Delivery:</span>
          <span class="font-bold text-stone-900"><%= @order.delivery_fee_cents.zero? ? 'FREE' : format_aud(@order.delivery_fee_cents) %></span>
        </div>
        <div class="flex justify-between text-stone-500 text-[11px] pt-1 border-t border-dashed border-stone-300">
          <span>Total includes 10% GST of:</span>
          <span class="font-bold text-stone-700"><%= format_aud(@order.gst_cents) %></span>
        </div>
        <div class="flex justify-between text-base font-black text-stone-900 pt-2 border-t-2 border-stone-900">
          <span>Total Amount Payable:</span>
          <span><%= @order.formatted_total %> AUD</span>
        </div>
      </div>
    </div>

    <!-- Footer Notes -->
    <div class="border-t border-stone-200 pt-6 text-[10px] text-stone-500 space-y-1">
      <p>Thank you for supporting your local Western Australian stockfeed and rural hardware supplier.</p>
      <p>Direct Enquiries: (08) 9571 8840 • Track this consignment online at <%= request.base_url %>/tracking/<%= @order.tracking_code %></p>
    </div>
  </div>
</body>
</html>

