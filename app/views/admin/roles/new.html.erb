<% content_for :title, "Create Custom Admin Role" %>

<div class="max-w-4xl mx-auto space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-black text-bush-900 tracking-tight">Create Custom Staff Role</h1>
      <p class="text-xs text-stone-500 mt-1">Define granular module access for a new store, warehouse, yard, or finance role.</p>
    </div>

    <%= link_to "← Back to Roles", admin_roles_path, class: "px-4 py-2 bg-stone-200 hover:bg-stone-300 text-stone-800 text-xs font-bold rounded-xl transition" %>
  </div>

  <%= render "form", role: @role %>
</div>

