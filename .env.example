# ==============================================================================
# Muchea Stockfeed & Hardware - Environment Variables (.env)
# ==============================================================================
#
# STRIPE PAYMENT GATEWAY CONFIGURATION:
# Provide your keys from the Stripe Dashboard (Settings -> API keys):
# ------------------------------------------------------------------------------

STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key

# (Optional) Stripe Webhook Signing Secret:
# STRIPE_WEBHOOK_SECRET=your_stripe_webhook_signing_secret

# Stripe Card Processing Surcharge (Method 2: Pass processing fee to customer)
# Standard Australian domestic cards: 1.75% + AU$ 0.30
STRIPE_SURCHARGE_ENABLED=true
STRIPE_SURCHARGE_PERCENT=1.75
STRIPE_SURCHARGE_FIXED_CENTS=30
