<!DOCTYPE html>
<html lang="en-AU" class="h-full bg-stone-50">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) ? "#{yield(:title)} | Muchea Stockfeed & Hardware" : "Muchea Stockfeed & Hardware | Rural Supplies, Equine Nutrition & Farm Hardware WA" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || "Premier Western Australian stockfeed and rural hardware supplier located in Muchea WA 6501. Horse feed, cattle grain, oaten hay, fencing wire, star pickets, and rural poly pipe delivered to Chittering, Bullsbrook, Gingin, and Bindoon." %>">
    <meta name="geo.region" content="AU-WA">
    <meta name="geo.placename" content="Muchea">
    <meta name="geo.position" content="-31.5790;115.9734">
    <meta name="ICBM" content="-31.5790, 115.9734">
    
    <!-- OpenGraph & Social Cards -->
    <meta property="og:site_name" content="Muchea Stockfeed & Hardware">
    <meta property="og:title" content="<%= content_for(:title) || "Muchea Stockfeed & Hardware — Western Australia" %>">
    <meta property="og:description" content="Horse feeds, hay, livestock nutrition, cyclone fencing, and farm hardware. Local scheduled truck deliveries & drive-thru warehouse pickup in Muchea, WA.">
    <meta property="og:image" content="<%= asset_path("muchea_logo.jpg") %>">
    <meta property="og:type" content="website">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Tailwind CSS CDN & Dynamic Global Brand Theme -->
    <script src="https://cdn.tailwindcss.com"></script>
    <%= render "shared/brand_theme" %>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@700;800&display=swap');
      body {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      }
      .font-serif-brand {
        font-family: 'Playfair Display', Georgia, serif;
      }
      .site-logo {
        width: 52px !important;
        height: 52px !important;
        min-width: 52px !important;
        min-height: 52px !important;
        max-width: 52px !important;
        max-height: 52px !important;
        object-fit: cover !important;
        border-radius: 12px;
        display: block !important;
        flex-shrink: 0 !important;
      }
    </style>

    <!-- Schema.org LocalBusiness Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Muchea Stockfeed & Hardware",
      "legalName": "Muchea Trading Pty Ltd",
      "image": "<%= request.base_url %>/images/muchea_logo.jpg",
      "telephone": "+61-8-9571-8840",
      "email": "sales@mucheastockfeed.com.au",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "17b Edwards Pl",
        "addressLocality": "Muchea",
        "addressRegion": "WA",
        "postalCode": "6501",
        "addressCountry": "AU"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": -31.5790,
        "longitude": 115.9734
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "07:30",
          "closes": "17:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Saturday",
          "opens": "08:00",
          "closes": "16:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Sunday",
          "opens": "09:00",
          "closes": "14:00"
        }
      ],
      "priceRange": "$$"
    }
    </script>

    <%= yield :head %>
  </head>

  <body class="min-h-full flex flex-col text-stone-800 bg-stone-50 antialiased selection:bg-brand-primary selection:text-white">
    <!-- Top Store Info Strip -->
    <aside aria-label="Store Announcement" class="bg-brand-dark text-stone-300 text-xs py-2 px-4 border-b border-stone-800">
      <div class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center gap-2">
        <div class="flex items-center gap-3">
          <span class="text-stone-100 font-semibold">17b Edwards Pl, Muchea WA 6501</span>
          <span class="hidden lg:inline text-stone-600">|</span>
          <span class="hidden lg:inline text-stone-400">Stockfeed, Chaff &amp; Hay Delivery Active</span>
          <% unless can_view_prices? %>
            <span class="hidden sm:inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-brand-primary/20 text-brand-accent border border-brand-primary/40">
              🔒 Prices Locked • Member Login Required
            </span>
          <% end %>
        </div>
        <div class="flex items-center gap-4 text-stone-300 text-xs">
          <a href="tel:0895718840" class="hover:text-white flex items-center gap-1.5 transition">
            <%= svg_icon("phone", css_class: "w-3.5 h-3.5 text-brand-primary") %>
            <span class="font-bold text-white">(08) 9571 8840</span>
          </a>
          <span class="text-stone-700">|</span>
          <div class="flex items-center gap-1.5">
            <%= svg_icon("clock", css_class: "w-3.5 h-3.5 text-stone-400") %>
            <span>Open 7:30am – 5:00pm</span>
          </div>
          <span class="text-stone-700">|</span>
          <%= link_to "Drive-Thru Bag Loading", drive_thru_pickup_path, class: "hover:text-white underline font-medium" %>
        </div>
      </div>
    </aside>

    <!-- Main Navigation Header -->
    <header class="bg-white border-b border-stone-200 sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between gap-3 md:gap-6">
        <!-- Brand Logo & Title -->
        <%= link_to root_path, class: "flex items-center gap-3 group flex-shrink-0" do %>
          <img src="/images/muchea_logo.jpg"
               alt="Muchea Stock Feed & Hardware Logo"
               class="site-logo rounded-lg border border-stone-900 shadow-xs transition duration-200"
               width="52"
               height="52"
               style="width: 52px; height: 52px; min-width: 52px; min-height: 52px; max-width: 52px; max-height: 52px; object-fit: cover;">
          <div class="flex-shrink-0">
            <div class="flex items-baseline gap-1.5 leading-none">
              <span class="text-xl sm:text-2xl font-black tracking-tight text-brand-primary uppercase font-sans">
                MUCHEA
              </span>
              <span class="text-xs sm:text-sm font-black tracking-wider text-stone-900 uppercase">
                STOCK FEED
              </span>
            </div>
            <div class="flex items-center gap-1.5 mt-0.5">
              <span class="text-[11px] font-bold text-stone-800 uppercase tracking-wide">&amp; HARDWARE</span>
            </div>
            <span class="block text-[11px] font-serif italic text-stone-500 mt-0.5">For Farms, Homes &amp; Lifestyles</span>
          </div>
        <% end %>

        <!-- Search Bar -->
        <div class="flex-1 max-w-xl mx-2 hidden md:block">
          <%= form_with url: products_path, method: :get, local: true, class: "relative" do |f| %>
            <div class="relative flex items-center">
              <%= f.text_field :q, value: params[:q], placeholder: "Search horse feed, lucerne chaff, oaten hay, cattle pellets, poultry...", class: "w-full pl-10 pr-24 py-2.5 rounded-lg border border-stone-300 bg-stone-50 text-xs focus:outline-none focus:ring-2 focus:ring-brand-dark focus:bg-white transition" %>
              <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-stone-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              </div>
              <button type="submit" class="absolute right-1 px-4 py-1.5 bg-brand-dark hover:bg-brand-primary text-white rounded-md text-xs font-bold transition cursor-pointer">
                Search
              </button>
            </div>
          <% end %>
        </div>

        <!-- Utility Actions & Cart Trigger -->
        <div class="flex items-center gap-2 sm:gap-3 flex-shrink-0">
          <!-- Member Auth Buttons (only shown when member price gating is enabled or customer is signed in) -->
          <% if customer_signed_in? %>
            <div class="flex items-center gap-1.5">
              <%= link_to customer_dashboard_path, class: "flex items-center gap-1.5 text-xs font-semibold px-2.5 py-1.5 rounded-lg border #{customer_approved? ? 'bg-emerald-50 text-emerald-800 border-emerald-300' : 'bg-amber-50 text-amber-900 border-amber-300'}" do %>
                <span><%= customer_approved? ? "👤 #{current_customer.first_name}" : "⏳ #{current_customer.first_name} (Pending)" %></span>
              <% end %>
              <%= button_to "Sign Out", customer_logout_path, method: :delete, class: "text-[11px] text-stone-500 hover:text-stone-900 font-semibold cursor-pointer hidden md:inline" %>
            </div>
          <% elsif ApplicationController.price_gating_enabled? %>
            <%= link_to "Member Login", customer_login_path, class: "hidden sm:inline-block text-xs font-semibold text-stone-700 hover:text-stone-950 px-2.5 py-1.5 rounded-lg transition" %>
            <%= link_to "Activate Account", customer_register_path, class: "text-xs font-bold bg-brand-primary/10 hover:bg-brand-primary text-brand-primary hover:text-white border border-brand-primary/30 px-3 py-1.5 rounded-lg transition whitespace-nowrap" %>
          <% end %>

          <%= link_to tracking_lookup_path, class: "hidden xl:flex items-center gap-1.5 text-xs font-semibold text-stone-700 hover:text-stone-950 bg-stone-100 hover:bg-stone-200 px-3 py-2 rounded-lg transition" do %>
            <%= svg_icon("truck", css_class: "w-4 h-4 text-brand-primary") %>
            <span>Track Order</span>
          <% end %>

          <%= link_to admin_root_path, class: "hidden sm:inline-block text-xs font-semibold text-stone-600 hover:text-stone-950 border border-stone-300 hover:bg-stone-100 px-3 py-2 rounded-lg transition", title: "Warehouse Staff Admin" do %>
            Staff
          <% end %>

          <!-- Cart Button -->
          <%= link_to cart_path, class: "relative flex items-center gap-2.5 bg-brand-primary hover:bg-brand-primary-hover text-white px-4 py-2 rounded-lg transition group" do %>
            <%= svg_icon("cart", css_class: "w-5 h-5 text-white") %>
            <div class="text-left">
              <span class="block text-[9px] text-white/90 uppercase leading-none font-semibold">Cart</span>
              <span class="block text-xs sm:text-sm font-bold leading-none mt-0.5"><%= format_aud(current_cart.total_cents) %></span>
            </div>
            <% if current_cart.item_count > 0 %>
              <span class="absolute -top-1.5 -right-1.5 bg-brand-dark text-white text-[10px] font-black w-5 h-5 rounded-full flex items-center justify-center border-2 border-white">
                <%= current_cart.item_count %>
              </span>
            <% end %>
          <% end %>
        </div>
      </div>

      <!-- Category Navigation Bar -->
      <nav class="bg-brand-dark text-stone-100 border-t border-stone-800 border-b-2 border-b-brand-primary overflow-x-auto scrollbar-none">
        <div class="max-w-7xl mx-auto px-4 flex items-center gap-1 text-xs sm:text-sm font-semibold whitespace-nowrap py-1">
          <%= link_to "All Stockfeed", products_path(department: "Stockfeed & Animal Nutrition"), class: "px-3 py-2 rounded hover:bg-stone-800 transition font-bold text-white" %>

          <% Category.live.each do |cat| %>
            <%= link_to cat.name, category_path(cat), class: "px-3 py-2 rounded hover:bg-stone-800 transition text-stone-200 hover:text-white #{'bg-brand-primary text-white font-bold' if @category == cat}" %>
          <% end %>

          <span class="text-stone-600 px-1">|</span>
          <%= link_to products_path(department: "Rural Hardware & Farm Supplies"), class: "px-3 py-2 rounded hover:bg-stone-800 transition flex items-center gap-1.5 text-stone-300" do %>
            <span>Hardware &amp; Fencing</span>
            <span class="bg-stone-800 text-brand-accent border border-stone-700 text-[9px] font-bold px-1.5 py-0.5 rounded uppercase">Soon</span>
          <% end %>

          <span class="text-stone-600 px-1">|</span>
          <%= link_to "Delivery Schedule", delivery_schedule_path, class: "px-3 py-2 rounded text-stone-300 hover:text-white hover:bg-stone-800 transition" %>
          <%= link_to "Drive-Thru Bay", drive_thru_pickup_path, class: "px-3 py-2 rounded text-stone-300 hover:text-white hover:bg-stone-800 transition" %>
        </div>
      </nav>
    </header>

    <!-- Mobile Search Bar -->
    <div class="md:hidden bg-white p-3 border-b border-stone-200">
      <%= form_with url: products_path, method: :get, local: true do |f| %>
        <div class="relative">
          <%= f.text_field :q, value: params[:q], placeholder: "Search feed, hay, fencing, pipe...", class: "w-full pl-9 pr-20 py-2 rounded-lg border border-stone-300 bg-stone-50 text-sm focus:outline-none" %>
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-stone-400">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          </div>
          <button type="submit" class="absolute inset-y-1 right-1 px-3 bg-bush-800 text-white rounded text-xs font-semibold">Search</button>
        </div>
      <% end %>
    </div>

    <!-- Flash Alerts -->
    <% if flash[:notice].present? %>
      <div class="bg-emerald-50 border-b border-emerald-200 text-emerald-900 text-sm py-2.5 px-4 text-center font-medium flex items-center justify-center gap-2">
        <%= svg_icon("check", css_class: "w-4 h-4 text-emerald-600") %>
        <span><%= flash[:notice] %></span>
      </div>
    <% end %>
    <% if flash[:alert].present? %>
      <div class="bg-rose-50 border-b border-rose-200 text-rose-900 text-sm py-2.5 px-4 text-center font-medium">
        <span><%= flash[:alert] %></span>
      </div>
    <% end %>

    <!-- Main Page Content -->
    <main class="flex-1">
      <%= yield %>
    </main>

    <!-- Australian Rural Store Footer -->
    <footer class="bg-brand-dark text-stone-300 border-t-4 border-brand-primary pt-12 pb-8 mt-16">
      <div class="max-w-7xl mx-auto px-4 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
        <!-- Column 1: Brand & Contact -->
        <div>
          <div class="flex items-center gap-3 mb-4">
            <img src="/images/muchea_logo.jpg" alt="Logo" class="w-12 h-12 rounded-lg border border-stone-700 flex-shrink-0" width="48" height="48" style="width: 48px; height: 48px; max-width: 48px; max-height: 48px; object-fit: cover;">
            <div>
              <h2 class="font-bold text-white text-lg tracking-wide uppercase font-sans">
                <span class="text-brand-primary font-black">MUCHEA</span> STOCK FEED
              </h2>
              <p class="text-xs text-stone-300 font-semibold tracking-wider uppercase">&amp; HARDWARE</p>
              <p class="text-[11px] font-serif italic text-stone-400">For Farms, Homes &amp; Lifestyles</p>
            </div>
          </div>
          <p class="text-xs text-stone-400 mb-4 leading-relaxed">
            Quality products for a stronger tomorrow. Serving horse properties, livestock farms, hobby blocks, and working dogs across Muchea, Chittering Valley, and Greater WA.
          </p>
          <div class="space-y-2 text-xs">
            <div class="flex items-start gap-2">
              <%= svg_icon("map-pin", css_class: "w-4 h-4 text-brand-primary flex-shrink-0 mt-0.5") %>
              <span>17b Edwards Pl, Muchea WA 6501</span>
            </div>
            <div class="flex items-center gap-2">
              <%= svg_icon("phone", css_class: "w-4 h-4 text-brand-primary flex-shrink-0") %>
              <a href="tel:0895718840" class="hover:text-white font-semibold">(08) 9571 8840</a>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              <span>sales@mucheastockfeed.com.au</span>
            </div>
          </div>
        </div>

        <!-- Column 2: Core Departments -->
        <div>
          <h3 class="text-white text-sm font-bold uppercase tracking-wider mb-4 border-b border-stone-800 pb-2">Departments</h3>
          <ul class="space-y-2 text-xs">
            <% Category.ordered.limit(6).each do |cat| %>
              <li>
                <%= link_to cat.name, category_path(cat), class: "hover:text-white transition" %>
              </li>
            <% end %>
            <li>
              <%= link_to "View All Products →", products_path, class: "text-brand-primary font-semibold hover:underline" %>
            </li>
          </ul>
        </div>

        <!-- Column 3: Customer Services & Legal Policies -->
        <div>
          <h3 class="text-white text-sm font-bold uppercase tracking-wider mb-4 border-b border-stone-800 pb-2">Services &amp; Policies</h3>
          <ul class="space-y-2 text-xs">
            <li><%= link_to "Weekly Delivery Runs", delivery_schedule_path, class: "hover:text-white" %></li>
            <li><%= link_to "Drive-Thru Bag Loading", drive_thru_pickup_path, class: "hover:text-white" %></li>
            <li><%= link_to "Track Order / Delivery", tracking_lookup_path, class: "hover:text-white" %></li>
            <li><%= link_to "Location & Trading Hours", contact_path, class: "hover:text-white" %></li>
            <li><%= link_to "About Our Store", about_path, class: "hover:text-white" %></li>
            <li class="pt-2 border-t border-stone-800/60 font-semibold text-brand-primary">
              <%= link_to "Refund & Returns Policy", refund_policy_path, class: "hover:underline text-stone-200" %>
            </li>
            <li class="font-semibold">
              <%= link_to "Terms & Conditions", terms_path, class: "hover:underline text-stone-200" %>
            </li>
            <li class="font-semibold">
              <%= link_to "Privacy Policy", privacy_path, class: "hover:underline text-stone-200" %>
            </li>
          </ul>
          <div class="mt-4 p-3 bg-stone-900 rounded-lg border border-stone-800 text-[11px] text-stone-300">
            <span class="font-bold text-white block mb-0.5">Drive-Thru Bag Loading:</span>
            Pull into 17b Edwards Pl with your ute, float, or trailer — we load your bags and bales for you.
          </div>
        </div>

        <!-- Column 4: Australian Business & Payment Security -->
        <div>
          <h3 class="text-white text-sm font-bold uppercase tracking-wider mb-4 border-b border-stone-800 pb-2">Store Details</h3>
          <div class="space-y-1.5 text-xs mb-4">
            <p><strong class="text-white">Legal Entity:</strong> Muchea Trading Pty Ltd</p>
            <p><strong class="text-white">ABN:</strong> 56 700 841 550</p>
            <p><strong class="text-white">ACN:</strong> 700 841 550</p>
            <p><strong class="text-white">Address:</strong> 17b Edwards Pl, Muchea WA 6501</p>
            <p><strong class="text-white">GST:</strong> All prices listed in AUD include 10% GST.</p>
            <p class="pt-1"><strong class="text-white">Trading Hours:</strong><br>
              Mon – Fri: 7:30am – 5:00pm<br>
              Saturday: 8:00am – 4:00pm<br>
              Sunday: 9:00am – 2:00pm
            </p>
          </div>
          <div class="pt-2 border-t border-stone-800">
            <span class="block text-[11px] uppercase font-bold text-stone-400 mb-2">Accepted Payments:</span>
            <div class="flex flex-wrap items-center gap-1.5">
              <span class="bg-stone-900 px-2 py-1 rounded text-[10px] font-bold text-white border border-stone-700">Visa</span>
              <span class="bg-stone-900 px-2 py-1 rounded text-[10px] font-bold text-white border border-stone-700">Mastercard</span>
              <span class="bg-stone-900 px-2 py-1 rounded text-[10px] font-bold text-white border border-stone-700">eftpos</span>
              <span class="bg-stone-900 px-2 py-1 rounded text-[10px] font-bold text-white border border-stone-700">Apple Pay</span>
              <span class="bg-stone-900 px-2 py-1 rounded text-[10px] font-bold text-white border border-stone-700">PayTo</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Copyright & Bottom Disclaimers -->
      <div class="max-w-7xl mx-auto px-4 border-t border-stone-800 pt-6 flex flex-col sm:flex-row justify-between items-center text-xs text-stone-500 gap-4">
        <p>&copy; <%= Time.current.year %> Muchea Trading Pty Ltd t/a Muchea Stockfeed &amp; Hardware. All Rights Reserved.</p>
        <div class="flex flex-wrap items-center gap-3">
          <%= link_to "Refund Policy", refund_policy_path, class: "hover:text-stone-300 underline" %>
          <span>•</span>
          <%= link_to "Terms", terms_path, class: "hover:text-stone-300 underline" %>
          <span>•</span>
          <%= link_to "Privacy", privacy_path, class: "hover:text-stone-300 underline" %>
          <span>•</span>
          <span>ABN 56 700 841 550</span>
          <span>•</span>
          <span>ACN 700 841 550</span>
          <span>•</span>
          <span>Prices in AUD (inc. GST)</span>
        </div>
      </div>
    </footer>
  </body>
</html>
