<%# Shared Price Gating Display Partial %>
<%# Usage: render "shared/price_gate", product: product, variant: nil %>
<% v = local_assigns[:variant] %>
<% p = local_assigns[:product] %>

<% if can_view_prices? %>
  <div>
    <span class="block text-base font-black text-stone-950">
      <%= v ? v.formatted_price : p.price_display %>
    </span>
    <span class="block text-[10px] text-stone-500">AUD inc. 10% GST</span>
  </div>
<% elsif customer_pending? %>
  <div>
    <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded text-[11px] font-bold bg-amber-50 text-amber-900 border border-amber-300">
      <span>⏳</span> Price Pending Approval
    </span>
    <span class="block text-[10px] text-stone-500 mt-0.5">Awaiting Super Admin review</span>
  </div>
<% else %>
  <div>
    <%= link_to customer_register_path, class: "group/lock inline-flex items-center gap-1.5 px-2.5 py-1 rounded text-[11px] font-extrabold bg-brand-primary/10 text-brand-primary border border-brand-primary/25 hover:bg-brand-primary hover:text-white transition" do %>
      <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
      <span>Activate Account to View Prices</span>
    <% end %>
    <span class="block text-[10px] text-stone-500 mt-0.5">
      Prices reserved for registered members
    </span>
  </div>
<% end %>
