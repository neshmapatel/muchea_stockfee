<% content_for :title, "Checkout | Muchea Stockfeed & Hardware" %>

<div class="bg-bush-900 text-white py-8 border-b-4 border-wheat-500">
  <div class="max-w-7xl mx-auto px-4">
    <span class="text-xs font-bold text-wheat-500 uppercase tracking-widest">Secure Checkout</span>
    <h1 class="text-2xl sm:text-4xl font-black font-serif-brand mt-1">Complete Your Rural Supplies Order</h1>
  </div>
</div>

<div class="max-w-7xl mx-auto px-4 py-10">
  <%= form_with url: process_checkout_path, method: :post, local: true, class: "space-y-8" do |f| %>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      <!-- Left Column: Customer & Delivery Details -->
      <div class="lg:col-span-7 space-y-6">
        <!-- 1. Customer Contact Details -->
        <div class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm space-y-4">
          <div class="flex items-center gap-2 border-b border-stone-100 pb-3">
            <span class="w-6 h-6 rounded-full bg-bush-800 text-white flex items-center justify-center text-xs font-bold">1</span>
            <h2 class="text-base font-bold text-stone-900">Contact & Invoicing Details</h2>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
            <div class="sm:col-span-2">
              <label class="block font-bold text-stone-700 mb-1">Full Name / Trading Name *</label>
              <%= f.text_field :customer_name, required: true, placeholder: "e.g. John Henderson (Henderson Equine)", class: "w-full px-3.5 py-2.5 rounded-xl border border-stone-300 bg-stone-50 focus:outline-none focus:ring-2 focus:ring-bush-800" %>
            </div>

            <div>
              <label class="block font-bold text-stone-700 mb-1">Email Address (for Tax Invoice & Tracking) *</label>
              <%= f.email_field :customer_email, required: true, placeholder: "john@hendersonequine.com.au", class: "w-full px-3.5 py-2.5 rounded-xl border border-stone-300 bg-stone-50 focus:outline-none focus:ring-2 focus:ring-bush-800" %>
            </div>

            <div>
              <label class="block font-bold text-stone-700 mb-1">Mobile Phone (for Driver SMS updates) *</label>
              <%= f.telephone_field :customer_phone, required: true, placeholder: "0412 345 678", class: "w-full px-3.5 py-2.5 rounded-xl border border-stone-300 bg-stone-50 focus:outline-none focus:ring-2 focus:ring-bush-800" %>
            </div>
          </div>
        </div>

        <!-- 2. Fulfillment Method & Rural Address -->
        <div class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm space-y-4">
          <div class="flex items-center gap-2 border-b border-stone-100 pb-3">
            <span class="w-6 h-6 rounded-full bg-bush-800 text-white flex items-center justify-center text-xs font-bold">2</span>
            <h2 class="text-base font-bold text-stone-900">Fulfillment Method & Rural Address</h2>
          </div>

          <div class="space-y-4 text-xs">
            <!-- Radio selector -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <label class="p-3.5 rounded-xl border-2 cursor-pointer flex items-center gap-3 <%= current_cart.fulfillment_type == 'delivery' ? 'border-bush-800 bg-bush-50' : 'border-stone-200 bg-white' %>">
                <input type="radio" name="fulfillment_type" value="delivery" <%= 'checked' if current_cart.fulfillment_type == 'delivery' %> onchange="toggleFulfillment(this.value)">
                <div>
                  <span class="block font-bold text-stone-900">🚜 Rural Truck Delivery</span>
                  <span class="text-[11px] text-stone-500">Delivered to paddock or feed shed</span>
                </div>
              </label>

              <label class="p-3.5 rounded-xl border-2 cursor-pointer flex items-center gap-3 <%= current_cart.fulfillment_type == 'pickup' ? 'border-bush-800 bg-bush-50' : 'border-stone-200 bg-white' %>">
                <input type="radio" name="fulfillment_type" value="pickup" <%= 'checked' if current_cart.fulfillment_type == 'pickup' %> onchange="toggleFulfillment(this.value)">
                <div>
                  <span class="block font-bold text-stone-900">🚗 Drive-Thru Bag Loading (FREE)</span>
                  <span class="text-[11px] text-stone-500">14 Great Northern Hwy, Muchea</span>
                </div>
              </label>
            </div>

            <!-- Address fields -->
            <div id="delivery-fields" class="<%= 'hidden' if current_cart.fulfillment_type == 'pickup' %> space-y-3 pt-2">
              <div>
                <label class="block font-bold text-stone-700 mb-1">Property Address / Lot Number *</label>
                <%= f.text_field :delivery_address, placeholder: "e.g. Lot 412 Chittering Road", class: "w-full px-3.5 py-2.5 rounded-xl border border-stone-300 bg-stone-50 focus:outline-none focus:ring-2 focus:ring-bush-800" %>
              </div>

              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block font-bold text-stone-700 mb-1">Suburb / Locality *</label>
                  <%= f.text_field :suburb, placeholder: "e.g. Lower Chittering, Bullsbrook, Gingin", class: "w-full px-3.5 py-2.5 rounded-xl border border-stone-300 bg-stone-50 focus:outline-none" %>
                </div>
                <div>
                  <label class="block font-bold text-stone-700 mb-1">WA Postcode *</label>
                  <%= f.text_field :postcode, value: current_cart.postcode, placeholder: "6084", class: "w-full px-3.5 py-2.5 rounded-xl border border-stone-300 bg-stone-50 focus:outline-none" %>
                </div>
              </div>

              <div>
                <label class="block font-bold text-stone-700 mb-1">Rural Gate Access & Unloading Instructions</label>
                <%= f.text_area :delivery_notes, rows: 2, placeholder: "e.g. Gate code #9941. Please leave pallet in the open hay shed on left of driveway. Beware: Friendly kelpie on property.", class: "w-full px-3.5 py-2 rounded-xl border border-stone-300 bg-stone-50 focus:outline-none" %>
              </div>
            </div>

            <div id="pickup-fields" class="<%= 'hidden' unless current_cart.fulfillment_type == 'pickup' %> p-4 bg-wheat-50 rounded-xl border border-wheat-200">
              <strong class="block text-bush-900 font-bold mb-1">Warehouse Drive-Thru Bay Instructions:</strong>
              <p class="text-[11px] text-stone-600">
                Drive straight into Bay 1 or Bay 2. Show your order confirmation SMS or name at the desk and our team will load your bags or forklift your pallet into your vehicle.
              </p>
            </div>
          </div>
        </div>

        <!-- 3. Payment Method -->
        <div class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm space-y-4">
          <div class="flex items-center gap-2 border-b border-stone-100 pb-3">
            <span class="w-6 h-6 rounded-full bg-bush-800 text-white flex items-center justify-center text-xs font-bold">3</span>
            <h2 class="text-base font-bold text-stone-900">Australian Payment Selection</h2>
          </div>

          <div class="space-y-3 text-xs">
            <div class="p-4 border-2 border-bush-800 rounded-xl bg-bush-50/50 space-y-3">
              <div class="flex items-center justify-between">
                <label class="flex items-center gap-2 font-bold text-stone-900 cursor-pointer">
                  <input type="radio" name="payment_method" value="Credit Card / Stripe" checked>
                  <span>Credit / Debit Card (Stripe Elements)</span>
                </label>
                <div class="flex items-center gap-1 text-[10px] font-bold text-stone-500">
                  <span class="bg-white px-1.5 py-0.5 rounded border border-stone-200">VISA</span>
                  <span class="bg-white px-1.5 py-0.5 rounded border border-stone-200">MC</span>
                  <span class="bg-white px-1.5 py-0.5 rounded border border-stone-200">AMEX</span>
                </div>
              </div>

              <!-- Card Input Simulation -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
                <div class="sm:col-span-2">
                  <label class="block text-[11px] font-bold text-stone-600 mb-1">Card Number</label>
                  <input type="text" placeholder="•••• •••• •••• 4242" value="4242 •••• •••• 4242" class="w-full px-3 py-2 rounded-lg border border-stone-300 bg-white font-mono focus:outline-none">
                </div>
                <div>
                  <label class="block text-[11px] font-bold text-stone-600 mb-1">Expiry Date</label>
                  <input type="text" placeholder="MM / YY" value="12 / 28" class="w-full px-3 py-2 rounded-lg border border-stone-300 bg-white font-mono focus:outline-none">
                </div>
                <div>
                  <label class="block text-[11px] font-bold text-stone-600 mb-1">CVC Security Code</label>
                  <input type="text" placeholder="CVC" value="312" class="w-full px-3 py-2 rounded-lg border border-stone-300 bg-white font-mono focus:outline-none">
                </div>
              </div>
            </div>

            <label class="p-3.5 border border-stone-200 rounded-xl flex items-center justify-between cursor-pointer hover:bg-stone-50">
              <div class="flex items-center gap-2 font-bold text-stone-800">
                <input type="radio" name="payment_method" value="Apple Pay / Google Pay">
                <span>Apple Pay / Google Pay</span>
              </div>
              <span class="text-[11px] text-stone-400">1-Touch Checkout</span>
            </label>

            <label class="p-3.5 border border-stone-200 rounded-xl flex items-center justify-between cursor-pointer hover:bg-stone-50">
              <div class="flex items-center gap-2 font-bold text-stone-800">
                <input type="radio" name="payment_method" value="Afterpay (4 Payments)">
                <span>Afterpay (4 fortnightly interest-free payments)</span>
              </div>
              <span class="text-[10px] bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded">Afterpay</span>
            </label>
          </div>
        </div>
      </div>

      <!-- Right Column: Order Confirmation Box -->
      <div class="lg:col-span-5 space-y-6">
        <div class="bg-white p-6 rounded-2xl border border-stone-200 shadow-sm space-y-5 sticky top-24">
          <h3 class="text-base font-bold text-bush-900 border-b border-stone-100 pb-3">Order Summary (<%= current_cart.item_count %> items)</h3>

          <div class="divide-y divide-stone-100 max-h-60 overflow-y-auto pr-1">
            <% current_cart.items.each do |item| %>
              <div class="py-2.5 flex justify-between items-center text-xs">
                <div>
                  <strong class="text-stone-900 block line-clamp-1"><%= item[:product].name %></strong>
                  <span class="text-[11px] text-stone-500"><%= item[:quantity] %>x <%= item[:variant].name %></span>
                </div>
                <span class="font-bold text-stone-900"><%= format_aud(item[:total_price_cents]) %></span>
              </div>
            <% end %>
          </div>

          <div class="space-y-2 text-xs pt-3 border-t border-stone-200">
            <div class="flex justify-between text-stone-600">
              <span>Subtotal (inc. GST)</span>
              <span class="font-bold text-stone-900"><%= format_aud(current_cart.subtotal_cents) %></span>
            </div>

            <div class="flex justify-between text-stone-600">
              <span>Delivery Fee</span>
              <span class="font-bold text-stone-900"><%= current_cart.fulfillment_type == 'pickup' ? 'FREE' : format_aud(current_cart.delivery_fee_cents) %></span>
            </div>

            <div class="flex justify-between text-stone-500 text-[11px]">
              <span>Australian GST (10% included)</span>
              <span><%= format_aud(current_cart.gst_cents) %></span>
            </div>

            <div class="flex justify-between items-baseline pt-3 border-t border-stone-200">
              <span class="text-sm font-bold text-stone-900">Total Payable</span>
              <div class="text-right">
                <span class="text-2xl font-black text-bush-900"><%= format_aud(current_cart.total_cents) %></span>
                <span class="block text-[10px] text-stone-400">AUD inc. 10% GST</span>
              </div>
            </div>
          </div>

          <%= f.submit "Place Order & Pay #{format_aud(current_cart.total_cents)}", class: "w-full py-4 bg-bush-800 hover:bg-bush-900 text-white font-extrabold text-xs uppercase tracking-wider rounded-xl shadow-lg transition cursor-pointer" %>

          <div class="text-[11px] text-stone-500 space-y-1 text-center pt-2">
            <p>✅ Australian Tax Invoice issued immediately</p>
            <p>✅ Tracking code sent via email & SMS</p>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<script>
  function toggleFulfillment(val) {
    var del = document.getElementById('delivery-fields');
    var pic = document.getElementById('pickup-fields');
    if (val === 'pickup') {
      del.classList.add('hidden');
      pic.classList.remove('hidden');
    } else {
      del.classList.remove('hidden');
      pic.classList.add('hidden');
    }
  }
</script>

